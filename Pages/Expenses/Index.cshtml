@page
@model CadenceAccounting.Pages.Expenses.IndexModel
@{
    ViewData["Title"] = "Expense Tracking";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-receipt me-2"></i>
                    Expense Tracking
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                    <i class="fas fa-plus me-2"></i>
                    Add Expense
                </button>
            </div>

            <!-- Expenses Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Expenses</h5>
                </div>
                <div class="card-body">
                    @if (Model.Expenses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Project</th>
                                        <th>Description</th>
                                        <th>Category</th>
                                        <th>Amount</th>
                                        <th>Receipt</th>
                                        <th>Billable</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in Model.Expenses)
                                    {
                                        <tr>
                                            <td>@expense.Date.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                <span class="badge bg-primary">@expense.Project.Name</span>
                                            </td>
                                            <td>@expense.Description</td>
                                            <td>
                                                <span class="badge bg-info">@expense.Category</span>
                                            </td>
                                            <td>@expense.Amount.ToString("C")</td>
                                            <td>
                                                @if (expense.ReceiptImage != null)
                                                {
                                                    <a href="/Expenses/Receipt/@expense.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-file-image"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No receipt</span>
                                                }
                                            </td>
                                            <td>
                                                @if (expense.IsBillable)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/Expenses/Edit/@expense.Id" class="btn btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@expense.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger" 
                                                                onclick="return confirm('Are you sure you want to delete this expense?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No expenses found</h5>
                            <p class="text-muted">Start tracking your expenses by adding your first entry.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>
                    Add Expense
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ProjectId" class="form-label"></label>
                            <select asp-for="Input.ProjectId" class="form-select">
                                <option value="">Select a project...</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Input.ProjectId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Date" class="form-label"></label>
                            <input asp-for="Input.Date" class="form-control" />
                            <span asp-validation-for="Input.Date" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Describe the expense..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Category" class="form-label"></label>
                            <input asp-for="Input.Category" class="form-control" list="categoryList" placeholder="Enter or select category..." />
                            <datalist id="categoryList">
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category"></option>
                                }
                            </datalist>
                            <span asp-validation-for="Input.Category" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Input.Amount" class="form-control" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Input.Amount" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.ReceiptFile" class="form-label"></label>
                        <input asp-for="Input.ReceiptFile" class="form-control" type="file" accept="image/*,.pdf" />
                        <div class="form-text">Upload receipt image (JPG, PNG, PDF)</div>
                        <span asp-validation-for="Input.ReceiptFile" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="Input.IsBillable" class="form-check-input" />
                        <label asp-for="Input.IsBillable" class="form-check-label"></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Save Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
