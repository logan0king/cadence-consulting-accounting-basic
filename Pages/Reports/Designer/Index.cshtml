            async function previewReport() {
                const reportId = getCurrentReportId();
                if (!reportId) {
                    alert('No report selected. Please create or load a report first.');
                    return;
                }

                try {
                    showLoadingDialog('Refreshing data...');
                    // Auto-refresh bound tables (SQL)
                    if (window.excelTables) {
                        const refreshPromises = Object.values(window.excelTables).map(t => t.refreshFromSql && t.refreshFromSql());
                        await Promise.all(refreshPromises);
                    }
                    hideLoadingDialog();

                    showLoadingDialog('Generating preview...');
                    
                    const response = await fetch(`?handler=PreviewReport&reportId=${reportId}`);
                    const result = await response.json();
                    
                    hideLoadingDialog();
                    
                    if (result.success && result.preview && result.preview.htmlContent) {
                        showReportPreviewDialog(result.preview);
                    } else {
                        const payload = typeof result === 'object' ? JSON.stringify(result, null, 2) : String(result);
                        alert('Preview returned no content. Details: ' + payload);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    alert('Error generating preview: ' + error.message);
                }
            }

            async function saveCurrentReport() {
                try {
                    console.log('Starting save process...');
                    
                    const reportId = getCurrentReportId();
                    console.log('Current report ID:', reportId);
                    
                    if (!reportId) {
                        // Prompt user for report name if none exists
                        const reportTitle = prompt('Please enter a name for your report:', 'My Report');
                        if (!reportTitle || reportTitle.trim() === '') {
                            alert('Report name is required to save.');
                            return;
                        }
                        
                        const reportDescription = prompt('Please enter a description for your report (optional):', '');
                        
                        console.log('No report ID found, creating new report with user input...');
                        const newReportId = await createNewReportWithUserInput(reportTitle.trim(), reportDescription || '');
                        if (!newReportId) {
                            alert('Failed to create new report');
                            return;
                        }
                        window.currentReportId = newReportId;
                        console.log('New report created with ID:', newReportId);
                    }

                    // Collect canvas data
                    const canvasData = {
                        objects: window.fabricCanvas.canvas.toJSON(['id', 'name', 'componentType']),
                        width: window.fabricCanvas.canvas.getWidth(),
                        height: window.fabricCanvas.canvas.getHeight(),
                        zoom: window.fabricCanvas.canvas.getZoom()
                    };

                    // Collect report metadata
                    const reportData = {
                        title: $('#reportTitle').val() || 'Untitled Report',
                        description: $('#reportDescription').val() || '',
                        canvasData: canvasData,
                        components: extractComponentsFromCanvas(),
                        relationships: extractRelationshipsFromCanvas()
                    };

                    console.log('Report data to save:', reportData);
                    console.log('Components count:', reportData.components.length);

                    showLoadingDialog('Saving report...');

                    const response = await fetch('?handler=SaveReport', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        body: new URLSearchParams({
                            reportId: window.currentReportId,
                            reportData: JSON.stringify(reportData),
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        })
                    });

                    const result = await response.json();
                    hideLoadingDialog();

                    if (result.success) {
                        alert('Report saved successfully!');
                        // Update the report title in the UI
                        $('#reportTitle').val(reportData.title);
                        updateReportNameDisplay(reportData.title); // Update the report name display
                        // Clear unsaved changes flag and disable save button
                        window.hasUnsavedChanges = false;
                        disableSaveButton();
                    } else {
                        console.error('Save failed:', result.error);
                        alert('Failed to save report: ' + result.error);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    console.error('Error saving report:', error);
                    alert('Error saving report: ' + error.message);
                }
            }

