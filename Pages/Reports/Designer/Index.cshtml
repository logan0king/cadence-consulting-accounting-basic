            async function previewReport() {
                const reportId = getCurrentReportId();
                if (!reportId) {
                    alert('No report selected. Please create or load a report first.');
                    return;
                }

                try {
                    showLoadingDialog('Generating preview...');
                    
                    const response = await fetch(`?handler=PreviewReport&reportId=${reportId}`);
                    const result = await response.json();
                    
                    hideLoadingDialog();
                    
                    if (result.success) {
                        showReportPreviewDialog(result.preview);
                    } else {
                        alert('Error generating preview: ' + result.error);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    alert('Error generating preview: ' + error.message);
                }
            }

            async function saveCurrentReport() {
                try {
                    const reportId = getCurrentReportId();
                    if (!reportId) {
                        // Create a new report if none exists
                        const newReportId = await createNewReport();
                        if (!newReportId) {
                            alert('Failed to create new report');
                            return;
                        }
                        window.currentReportId = newReportId;
                    }

                    // Collect canvas data
                    const canvasData = {
                        objects: window.fabricCanvas.canvas.toJSON(['id', 'name', 'componentType']),
                        width: window.fabricCanvas.canvas.getWidth(),
                        height: window.fabricCanvas.canvas.getHeight(),
                        zoom: window.fabricCanvas.canvas.getZoom()
                    };

                    // Collect report metadata
                    const reportData = {
                        title: $('#reportTitle').val() || 'Untitled Report',
                        description: $('#reportDescription').val() || '',
                        canvasData: canvasData,
                        components: extractComponentsFromCanvas(),
                        relationships: extractRelationshipsFromCanvas()
                    };

                    showLoadingDialog('Saving report...');

                    const response = await fetch('?handler=SaveReport', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        body: JSON.stringify({
                            reportId: window.currentReportId,
                            reportData: JSON.stringify(reportData)
                        })
                    });

                    const result = await response.json();
                    hideLoadingDialog();

                    if (result.success) {
                        alert('Report saved successfully!');
                        // Update the report title in the UI
                        $('#reportTitle').val(reportData.title);
                    } else {
                        alert('Error saving report: ' + result.error);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    alert('Error saving report: ' + error.message);
                }
            }

            function getCurrentReportId() {
                // This would be set when a report is created or loaded
                return window.currentReportId || null;
            }

            async function createNewReport() {
                try {
                    const formData = new FormData();
                    formData.append('title', 'New Report');
                    formData.append('description', 'Created from Report Designer');
                    formData.append('reportGroup', 'General');
                    formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
                    
                    const response = await fetch('?handler=CreateReport', {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('HTTP Error:', response.status, response.statusText);
                        console.error('Error response:', errorText);
                        return null;
                    }

                    const result = await response.json();
                    if (result.success) {
                        enableSaveButton();
                        return result.reportId;
                    } else {
