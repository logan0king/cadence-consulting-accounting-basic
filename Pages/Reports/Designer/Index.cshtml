                    alert('No report selected. Please create or load a report first.');
                    return;
                }

                try {
                    showLoadingDialog('Generating SQL...');
                    
                    const response = await fetch(`?handler=GenerateSql&reportId=${reportId}`);
                    const result = await response.json();
                    
                    hideLoadingDialog();
                    
                    if (result.success) {
                        showSqlDialog(result.sql);
                    } else {
                        alert('Error generating SQL: ' + result.error);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    alert('Error generating SQL: ' + error.message);
