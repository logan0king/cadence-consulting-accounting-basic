        async function saveParameter(event) {
            event.preventDefault();
            const form = $('#parameterForm');
            const paramId = form.attr('data-param-id');
            const reportId = form.attr('data-report-id');
            
            const parameter = {
                id: paramId || generateGuid(),
                reportId: reportId,
                parameterName: $('#parameterName').val(),
                parameterType: parseInt($('#parameterType').val()),
                prompt: $('#parameterPrompt').val(),
                defaultValue: $('#parameterDefault').val(),
                required: $('#parameterRequired').is(':checked'),
                sortOrder: 0
            };

            try {
                const response = await fetch('/Reports/Designer?handler=SaveParameter', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify(parameter)
                });

                if (response.ok) {
                    $('#parameterModal').modal('hide');
                    showParametersPanel(); // Refresh the panel
                } else {
                    alert('Failed to save parameter');
                }
            } catch (error) {
                console.error('Error saving parameter:', error);
                alert('Error saving parameter: ' + error.message);
            }
        }

