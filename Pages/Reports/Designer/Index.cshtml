                alert('Error deleting parameter: ' + error.message);
            }
        }

        async function editParameter(paramId) {
            try {
                const response = await fetch(`/Reports/Designer?handler=GetParameter&parameterId=${paramId}`);
                if (response.ok) {
                    const param = await response.json();
                    showEditParameterModal(param);
                } else {
                    alert('Failed to load parameter');
                }
            } catch (error) {
                console.error('Error loading parameter:', error);
                alert('Error loading parameter: ' + error.message);
            }
        }

        // Filter Management Functions
        async function showFiltersPanel() {
            const reportId = window.currentReportId;
            if (!reportId) {
                alert('Please save the report first before adding filters');
                return;
            }

            try {
                // Load filters for this report
                const filters = await loadFilters(reportId);
                renderFiltersPanel(filters, reportId);
            } catch (error) {
                console.error('Error loading filters:', error);
                alert('Error loading filters: ' + error.message);
            }
        }

        async function loadFilters(reportId) {
            try {
                const response = await fetch(`/Reports/Designer?handler=GetFilters&reportId=${reportId}`);
                if (response.ok) {
                    return await response.json();
                }
                return [];
            } catch (error) {
                console.error('Error loading filters:', error);
                return [];
            }
        }

        function renderFiltersPanel(filters, reportId) {
            const panel = $('#propertyContent');
            panel.empty();
            
            let html = `
                <div class="property-section">
                    <h6 class="property-section-title"><i class="fas fa-filter me-2"></i>Report Filters</h6>
                    
                    <div class="mb-3">
                        <button class="btn btn-primary btn-sm" onclick="showAddFilterModal('${reportId}')">
                            <i class="fas fa-plus"></i> Add Filter
                        </button>
                    </div>
                    
                    <div id="filtersList">
            `;
            
            if (filters && filters.length > 0) {
                filters.forEach(filter => {
                    html += renderFilterItem(filter);
                });
            } else {
                html += '<div class="alert alert-info">No filters defined</div>';
            }
            
            html += `
                    </div>
                </div>
            `;
            
            panel.html(html);
        }

        function renderFilterItem(filter) {
            const operatorNames = {
                0: 'Equals', 1: 'Not Equals', 2: 'Greater Than', 3: 'Greater Than or Equal',
                4: 'Less Than', 5: 'Less Than or Equal', 6: 'Contains', 7: 'Starts With',
                8: 'Ends With', 9: 'Between', 10: 'In', 11: 'Not In', 12: 'Is Null', 13: 'Is Not Null'
            };
            
            const logicNames = {
                0: '', 1: 'AND', 2: 'OR'
            };
            
            return `
                <div class="card mb-2" data-filter-id="${filter.id}">
                    <div class="card-body">
                        <h6 class="card-title">${filter.tableName}.${filter.columnName}</h6>
                        <p class="card-text"><small>Operator: ${operatorNames[filter.operator]}</small></p>
                        ${filter.filterValue ? `<p class="card-text"><small>Value: ${filter.filterValue}</small></p>` : ''}
                        <p class="card-text"><small>Logic: ${logicNames[filter.logicOperator] || 'None'}</small></p>
                        <div class="mt-2">
                            <button class="btn btn-sm btn-secondary" onclick="editFilter('${filter.id}')">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteFilter('${filter.id}')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function showAddFilterModal(reportId) {
            $('#filterModalTitle').text('Add Filter');
            $('#filterForm')[0].reset();
            $('#filterForm').attr('data-filter-id', '');
            $('#filterForm').attr('data-report-id', reportId);
            $('#filterModal').modal('show');
        }

        function showEditFilterModal(filter) {
            $('#filterModalTitle').text('Edit Filter');
            $('#filterTable').val(filter.tableName);
            $('#filterColumn').val(filter.columnName);
            $('#filterOperator').val(filter.operator);
            $('#filterValue').val(filter.filterValue || '');
            $('#filterLogic').val(filter.logicOperator);
            $('#filterForm').attr('data-filter-id', filter.id);
            $('#filterModal').modal('show');
        }

        async function saveFilter(event) {
            event.preventDefault();
            const form = $('#filterForm');
            const filterId = form.attr('data-filter-id');
            const reportId = form.attr('data-report-id');
            
            const filter = {
                id: filterId || generateGuid(),
                reportId: reportId,
                tableName: $('#filterTable').val(),
                columnName: $('#filterColumn').val(),
                operator: parseInt($('#filterOperator').val()),
                filterValue: $('#filterValue').val(),
                logicOperator: parseInt($('#filterLogic').val()),
                sortOrder: 0
            };

            try {
                const response = await fetch('/Reports/Designer?handler=SaveFilter', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify(filter)
                });

                if (response.ok) {
                    $('#filterModal').modal('hide');
                    showFiltersPanel(); // Refresh the panel
                } else {
                    alert('Failed to save filter');
                }
            } catch (error) {
                console.error('Error saving filter:', error);
                alert('Error saving filter: ' + error.message);
            }
        }

        async function deleteFilter(filterId) {
            if (!confirm('Are you sure you want to delete this filter?')) {
                return;
            }

            try {
                const response = await fetch(`/Reports/Designer?handler=DeleteFilter&filterId=${filterId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                });

                if (response.ok) {
                    showFiltersPanel(); // Refresh the panel
                } else {
                    alert('Failed to delete filter');
                }
            } catch (error) {
                console.error('Error deleting filter:', error);
                alert('Error deleting filter: ' + error.message);
            }
        }

        async function editFilter(filterId) {
            try {
                const response = await fetch(`/Reports/Designer?handler=GetFilter&filterId=${filterId}`);
                if (response.ok) {
                    const filter = await response.json();
                    showEditFilterModal(filter);
                } else {
                    alert('Failed to load filter');
                }
            } catch (error) {
                console.error('Error loading filter:', error);
                alert('Error loading filter: ' + error.message);
            }
        }

        // Wizard Functions
        function startReportWizard() {
            window.location.href = '/Reports/Wizard';
        }
    </script>

    <!-- Parameter Management Modal -->
    <div class="modal fade" id="parameterModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="parameterModalTitle">Add Parameter</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="parameterForm" onsubmit="saveParameter(event)">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="parameterName">Parameter Name</label>
                            <input type="text" class="form-control" id="parameterName" required 
                                placeholder="e.g., StartDate, ProjectId" />
                        </div>
                        
                        <div class="form-group">
                            <label for="parameterType">Parameter Type</label>
                            <select class="form-control" id="parameterType" required>
                                <option value="0">Text</option>
                                <option value="1">Integer</option>
                                <option value="2">Decimal</option>
                                <option value="3">DateTime</option>
                                <option value="4">Boolean</option>
                                <option value="5">DateRange</option>
                                <option value="6">LookupSingle</option>
                                <option value="7">LookupMulti</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="parameterPrompt">Prompt Text</label>
                            <input type="text" class="form-control" id="parameterPrompt" 
                                placeholder="e.g., Enter start date" />
                        </div>
                        
                        <div class="form-group">
                            <label for="parameterDefault">Default Value</label>
                            <input type="text" class="form-control" id="parameterDefault" 
                                placeholder="Optional default value" />
                        </div>
                        
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="parameterRequired" />
                            <label class="form-check-label" for="parameterRequired">
                                Required
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Filter Management Modal -->
    <div class="modal fade" id="filterModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="filterModalTitle">Add Filter</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="filterForm" onsubmit="saveFilter(event)">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="filterTable">Table Name</label>
                            <input type="text" class="form-control" id="filterTable" required 
                                placeholder="e.g., Projects, Expenses" />
                        </div>
                        
                        <div class="form-group">
                            <label for="filterColumn">Column Name</label>
                            <input type="text" class="form-control" id="filterColumn" required 
                                placeholder="e.g., ProjectName, Amount" />
                        </div>
                        
                        <div class="form-group">
                            <label for="filterOperator">Operator</label>
                            <select class="form-control" id="filterOperator" required>
                                <option value="0">Equals</option>
                                <option value="1">Not Equals</option>
                                <option value="2">Greater Than</option>
                                <option value="3">Greater Than or Equal</option>
                                <option value="4">Less Than</option>
                                <option value="5">Less Than or Equal</option>
                                <option value="6">Contains</option>
                                <option value="7">Starts With</option>
                                <option value="8">Ends With</option>
                                <option value="9">Between</option>
                                <option value="10">In</option>
                                <option value="11">Not In</option>
                                <option value="12">Is Null</option>
                                <option value="13">Is Not Null</option>
                            </select>
                        </div>
                        
                        <div class="form-group" id="filterValueGroup">
                            <label for="filterValue">Filter Value</label>
                            <input type="text" class="form-control" id="filterValue" 
                                placeholder="Enter filter value" />
                        </div>
                        
                        <div class="form-group">
                            <label for="filterLogic">Logic Operator</label>
                            <select class="form-control" id="filterLogic">
                                <option value="0">None (First Filter)</option>
                                <option value="1">AND</option>
                                <option value="2">OR</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}