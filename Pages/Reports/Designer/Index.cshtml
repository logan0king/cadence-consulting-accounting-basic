                        return null;
                    }
                } catch (error) {
                    console.error('Error creating report:', error);
                    return null;
                }
            }

            function extractComponentsFromCanvas() {
                const components = [];
                const objects = window.fabricCanvas.canvas.getObjects();
                
                objects.forEach((obj, index) => {
                    if (obj.componentType) {
                        components.push({
                            id: obj.id || `component_${index}`,
                            componentType: obj.componentType,
                            positionX: Math.round(obj.left),
                            positionY: Math.round(obj.top),
                            width: Math.round(obj.width * obj.scaleX),
                            height: Math.round(obj.height * obj.scaleY),
                            properties: JSON.stringify({
                                text: obj.text || '',
                                fontSize: obj.fontSize || 12,
                                fontFamily: obj.fontFamily || 'Arial',
                                fill: obj.fill || '#000000',
                                backgroundColor: obj.backgroundColor || 'transparent',
                                borderColor: obj.borderColor || 'transparent',
                                borderWidth: obj.borderWidth || 0,
                                rotation: obj.angle || 0,
                                opacity: obj.opacity || 1,
                                visible: obj.visible !== false
                            }),
                            dataBinding: obj.dataBinding ? JSON.stringify(obj.dataBinding) : null,
                            zIndex: obj.zIndex || index,
                            isVisible: obj.visible !== false
                        });
                    }
                });
                
                return components;
            }

