            // Sidebar Resize Functionality
            function setupSidebarResize() {
                const sidebar = document.querySelector('.right-sidebar');
                const resizeHandle = document.querySelector('.sidebar-resize-handle');
                
                if (!sidebar || !resizeHandle) return;
                
                // Load saved width from localStorage
                const savedWidth = localStorage.getItem('sidebarWidth');
                if (savedWidth) {
                    sidebar.style.width = savedWidth + 'px';
                    sidebar.style.flexShrink = '0'; // Prevent sidebar from shrinking
                    sidebar.style.flexGrow = '0'; // Prevent sidebar from growing
                    sidebar.style.marginLeft = 'auto'; // Keep on right
                }
                
                let isResizing = false;
                let startX = 0;
                let startWidth = 0;
                
                resizeHandle.addEventListener('mousedown', (e) => {
                    isResizing = true;
                    startX = e.clientX;
                    startWidth = sidebar.offsetWidth;
                    
                    // Prevent text selection while dragging
                    document.body.style.userSelect = 'none';
                    document.body.style.cursor = 'col-resize';
                    
                    document.addEventListener('mousemove', onMouseMove);
                    document.addEventListener('mouseup', onMouseUp);
                    
                    e.preventDefault();
                    e.stopPropagation();
                });
                
                const onMouseMove = (e) => {
                    if (!isResizing) return;
                    
                    // Calculate width change based on mouse movement
                    // Drag left (toward the left side) = make sidebar wider
                    // Drag right (toward the right side) = make sidebar narrower
                    const diff = startX - e.clientX; // Invert: left = positive, right = negative
                    const newWidth = Math.max(200, Math.min(800, startWidth + diff));
                    
                    sidebar.style.width = newWidth + 'px';
                    sidebar.style.flexShrink = '0'; // Keep sidebar fixed width
                    sidebar.style.flexGrow = '0'; // Prevent growing
                    sidebar.style.marginLeft = 'auto'; // Keep on right
                };
                
                const onMouseUp = () => {
                    if (isResizing) {
                        // Save the new width to localStorage
                        localStorage.setItem('sidebarWidth', sidebar.offsetWidth);
                    }
                    isResizing = false;
                    
                    // Restore cursor and selection
                    document.body.style.userSelect = '';
                    document.body.style.cursor = '';
                    
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);
                };
            }

            // Data Binding Functions
            function applyDataBinding() {
                const selectedObject = window.fabricCanvas.canvas.getActiveObject();
                if (!selectedObject) {
                    alert('Please select a component first');
                    return;
                }
                
                const tableName = $('#dataBindingTable').val();
                const fieldName = $('#dataBindingField').val();
                
                if (!tableName || !fieldName) {
                    alert('Please select both a table and a field');
                    return;
                }
                
                // Create data binding object
                const dataBinding = {
                    tableName: tableName,
                    fieldName: fieldName,
                    dataType: 'string'
                };
                
                // Store in component's custom properties
                selectedObject.dataBinding = JSON.stringify(dataBinding);
                
                // Update the visual display
                if (selectedObject.componentType === 'textbox' || selectedObject.componentType === 'label') {
                    selectedObject.set('text', `[${tableName}.${fieldName}]`);
                }
                
                selectedObject.setCoords();
                window.fabricCanvas.canvas.renderAll();
                
                // Save to database
                saveComponentDataBinding(selectedObject.id, dataBinding);
                
                alert('Data binding applied successfully');
                
                // Close the data binding panel and return to properties view
                if (window.propertyGrid) {
                    window.propertyGrid.updateProperties(selectedObject);
                }
            }

            function clearDataBinding() {
                const selectedObject = window.fabricCanvas.canvas.getActiveObject();
                if (selectedObject) {
                    selectedObject.dataBinding = null;
                    if (selectedObject.componentType === 'textbox' || selectedObject.componentType === 'label') {
                        selectedObject.set('text', selectedObject.componentType === 'textbox' ? 'Text' : 'Label');
                    }
                    selectedObject.setCoords();
                    window.fabricCanvas.canvas.renderAll();
                    
                    saveComponentDataBinding(selectedObject.id, null);
                    alert('Data binding cleared');
                }
            }

            async function saveComponentDataBinding(componentId, dataBinding) {
                try {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    
                    const response = await fetch(`/Reports/Designer?handler=SaveDataBinding&componentId=${componentId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ dataBinding: dataBinding })
                    });
                    
                    if (response.ok) {
                        console.log('Data binding saved successfully');
                    } else {
                        console.error('Failed to save data binding');
                    }
                } catch (error) {
                    console.error('Error saving data binding:', error);
