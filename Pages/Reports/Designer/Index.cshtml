            function validateReport() {
                const canvas = window.fabricCanvas.canvas;
                const objects = canvas.getObjects();
                const issues = [];

                // Check for empty canvas
                if (objects.length === 0) {
                    issues.push('Report canvas is empty. Add some components to create a report.');
                }

                // Check for overlapping objects
                for (let i = 0; i < objects.length; i++) {
                    for (let j = i + 1; j < objects.length; j++) {
                        if (isOverlapping(objects[i], objects[j])) {
                            issues.push(`Objects "${objects[i].name || 'Unnamed'}" and "${objects[j].name || 'Unnamed'}" are overlapping.`);
                        }
                    }
                }

                // Check for objects outside canvas bounds
                objects.forEach(obj => {
                    if (obj.left < 0 || obj.top < 0 || 
                        obj.left + obj.getScaledWidth() > canvas.width || 
                        obj.top + obj.getScaledHeight() > canvas.height) {
                        issues.push(`Object "${obj.name || 'Unnamed'}" extends outside the canvas bounds.`);
                    }
                });

                // Check for required properties
                objects.forEach(obj => {
                    if (obj.componentType === 'textbox' && (!obj.text || obj.text.trim() === '')) {
                        issues.push(`Text box "${obj.name || 'Unnamed'}" is empty.`);
                    }
                });

                // Display validation results
                if (issues.length === 0) {
                    alert('✅ Report validation passed! No issues found.');
                } else {
                    const message = '❌ Report validation failed:\n\n' + issues.join('\n');
                    alert(message);
                }
            }

            function isOverlapping(obj1, obj2) {
                const rect1 = {
                    left: obj1.left,
                    top: obj1.top,
                    right: obj1.left + obj1.getScaledWidth(),
                    bottom: obj1.top + obj1.getScaledHeight()
                };

                const rect2 = {
                    left: obj2.left,
                    top: obj2.top,
                    right: obj2.left + obj2.getScaledWidth(),
                    bottom: obj2.top + obj2.getScaledHeight()
                };

                return !(rect1.right < rect2.left || 
                        rect1.left > rect2.right || 
                        rect1.bottom < rect2.top || 
                        rect1.top > rect2.bottom);
            }

