        class KeyboardManager {
            constructor(canvasManager) {
                this.canvasManager = canvasManager;
                this.setupKeyboardShortcuts();
            }

            initialize() {
                // Additional initialization if needed
            }

            setupKeyboardShortcuts() {
                $(document).on('keydown', (e) => {
                    if (e.ctrlKey) {
                        switch (e.key) {
                            case 's':
                                e.preventDefault();
                                saveCurrentReport();
                                break;
                            case 'n':
                                e.preventDefault();
                                $('#newReportBtn').click();
                                break;
                            case 'p':
                                e.preventDefault();
                                previewReport();
                                break;
                            case 'z':
                                e.preventDefault();
                                // Undo functionality
                                break;
                            case 'y':
                                e.preventDefault();
                                // Redo functionality
                                break;
                            case 'c':
                                e.preventDefault();
                                // Copy functionality
                                break;
                            case 'v':
                                e.preventDefault();
                                // Paste functionality
                                break;
                            case 'd':
                                e.preventDefault();
                                // Duplicate functionality
                                break;
                            case 'a':
                                e.preventDefault();
                                this.canvasManager.canvas.discardActiveObject();
                                this.canvasManager.canvas.setActiveObject(new fabric.ActiveSelection(this.canvasManager.canvas.getObjects(), {
                                    canvas: this.canvasManager.canvas,
                                }));
                                this.canvasManager.canvas.requestRenderAll();
                                break;
                        }
                    } else if (e.key === 'Delete') {
                        const activeObjects = this.canvasManager.canvas.getActiveObjects();
                        if (activeObjects.length > 0) {
                            this.canvasManager.canvas.remove(...activeObjects);
                            this.canvasManager.canvas.discardActiveObject();
                            this.canvasManager.canvas.renderAll();
                            
                            // Update save button state when objects are removed
                            if (typeof updateSaveButtonState === 'function') {
                                window.updateSaveButtonState();
                            }
                        }
                    } else if (e.key === 'F1') {
                        e.preventDefault();
                        showKeyboardShortcuts();
                    }
                });
            }
        }

