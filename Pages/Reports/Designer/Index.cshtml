                $('#prop-checked').on('change', () => this.updateObjectProperty('checked', $('#prop-checked').is(':checked')));
                $('#prop-shapeType').on('change', () => this.updateObjectProperty('shapeType', $('#prop-shapeType').val()));
                $('#prop-value').on('change', () => this.updateObjectProperty('value', parseFloat($('#prop-value').val())));
                
                // Layout properties
                $('#prop-left').on('change', () => this.updateObjectProperty('left', parseInt($('#prop-left').val())));
                $('#prop-top').on('change', () => this.updateObjectProperty('top', parseInt($('#prop-top').val())));
                $('#prop-width').on('change', () => this.updateObjectProperty('width', parseInt($('#prop-width').val())));
                $('#prop-height').on('change', () => this.updateObjectProperty('height', parseInt($('#prop-height').val())));
                $('#prop-textAlign').on('change', () => this.updateObjectProperty('textAlign', $('#prop-textAlign').val()));
                
                // Appearance properties
                $('#prop-fontSize').on('change', () => this.updateObjectProperty('fontSize', parseInt($('#prop-fontSize').val())));
                $('#prop-fontWeight').on('change', () => this.updateObjectProperty('fontWeight', $('#prop-fontWeight').val()));
                $('#prop-fontStyle').on('change', () => this.updateObjectProperty('fontStyle', $('#prop-fontStyle').val()));
                $('#prop-textDecoration').on('change', () => this.updateObjectProperty('textDecoration', $('#prop-textDecoration').val()));
                $('#prop-fill').on('change', () => this.updateObjectProperty('fill', $('#prop-fill').val()));
                $('#prop-background').on('change', () => this.updateObjectProperty('backgroundColor', $('#prop-background').val()));
                $('#prop-stroke').on('change', () => this.updateObjectProperty('stroke', $('#prop-stroke').val()));
                $('#prop-strokeWidth').on('change', () => this.updateObjectProperty('strokeWidth', parseInt($('#prop-strokeWidth').val())));
                $('#prop-strokeDashArray').on('change', () => {
                    const value = $('#prop-strokeDashArray').val();
                    this.updateObjectProperty('strokeDashArray', value ? value.split(',').map(Number) : null);
                });
                
                // Data properties
                $('#prop-dataSource').on('change', () => this.updateObjectProperty('dataSource', $('#prop-dataSource').val()));
                $('#prop-fieldName').on('change', () => this.updateObjectProperty('fieldName', $('#prop-fieldName').val()));
                $('#prop-formatString').on('change', () => this.updateObjectProperty('formatString', $('#prop-formatString').val()));
            }

            updateProperties(object) {
                if (!object) return;
                
                this.currentObject = object;
                
                // Show/hide property groups based on component type
                this.showRelevantPropertyGroups(object.componentType);
                
                // Design properties
                $('#prop-name').val(object.name || '');
                $('#prop-text').val(object.text || '');
                $('#prop-checked').prop('checked', object.checked || false);
                $('#prop-shapeType').val(object.shapeType || 'rectangle');
                $('#prop-value').val(object.value || 0.75);
                
                // Layout properties
                $('#prop-left').val(object.left || 0);
                $('#prop-top').val(object.top || 0);
                $('#prop-width').val(object.width || 0);
                $('#prop-height').val(object.height || 0);
                $('#prop-textAlign').val(object.textAlign || 'left');
                
                // Appearance properties
                $('#prop-fontSize').val(object.fontSize || 14);
                $('#prop-fontWeight').val(object.fontWeight || 'normal');
                $('#prop-fontStyle').val(object.fontStyle || 'normal');
                $('#prop-textDecoration').val(object.textDecoration || 'none');
                // Convert colors to hex format for color inputs
                const fillColor = this.convertToHex(object.fill === 'transparent' ? '#ffffff' : (object.fill || '#000000'));
                const bgColor = this.convertToHex(object.backgroundColor === 'transparent' ? '#ffffff' : (object.backgroundColor || '#ffffff'));
                const strokeColor = this.convertToHex(object.stroke === 'transparent' ? '#000000' : (object.stroke || '#000000'));
                
                $('#prop-fill').val(fillColor);
                $('#prop-background').val(bgColor);
                $('#prop-stroke').val(strokeColor);
                $('#prop-strokeWidth').val(object.strokeWidth || 1);
                $('#prop-strokeDashArray').val(object.strokeDashArray ? object.strokeDashArray.join(',') : '');
                
                // Data properties
                $('#prop-dataSource').val(object.dataSource || '');
                $('#prop-fieldName').val(object.fieldName || '');
                $('#prop-formatString').val(object.formatString || '');
            }

            showRelevantPropertyGroups(componentType) {
                // Hide all conditional property groups first
                $('#prop-checked-group').hide();
                $('#prop-shapeType-group').hide();
                $('#prop-value-group').hide();
                $('#prop-strokeDashArray-group').hide();
                
                // Show relevant groups based on component type
                switch (componentType) {
                    case 'checkbox':
                        $('#prop-checked-group').show();
                        break;
                    case 'shape':
                        $('#prop-shapeType-group').show();
                        break;
                    case 'gauge':
                        $('#prop-value-group').show();
                        break;
                    case 'picturebox':
                    case 'crossbandline':
                    case 'crossbandbox':
                        $('#prop-strokeDashArray-group').show();
                        break;
                }
            }

            updateObjectProperty(property, value) {
                if (this.currentObject) {
                    this.currentObject.set(property, value);
                    this.currentObject.canvas.renderAll();
                }
            }

            clearProperties() {
                this.currentObject = null;
                
                // Hide all conditional property groups
                $('#prop-checked-group').hide();
                $('#prop-shapeType-group').hide();
                $('#prop-value-group').hide();
                $('#prop-strokeDashArray-group').hide();
                
                // Clear all property values
                $('#prop-name').val('');
                $('#prop-text').val('');
                $('#prop-checked').prop('checked', false);
                $('#prop-shapeType').val('rectangle');
                $('#prop-value').val('0.75');
                $('#prop-left').val('');
                $('#prop-top').val('');
                $('#prop-width').val('');
                $('#prop-height').val('');
                $('#prop-textAlign').val('left');
                $('#prop-fontSize').val('');
                $('#prop-fontWeight').val('normal');
                $('#prop-fontStyle').val('normal');
                $('#prop-textDecoration').val('none');
                $('#prop-fill').val('#000000');
                $('#prop-background').val('#ffffff');
                $('#prop-stroke').val('#000000');
                $('#prop-strokeWidth').val('1');
                $('#prop-strokeDashArray').val('');
                $('#prop-dataSource').val('');
                $('#prop-fieldName').val('');
                $('#prop-formatString').val('');
            }

            convertToHex(color) {
                if (!color) return '#000000';
                
                // If it's already a hex color, return it
                if (color.startsWith('#')) {
                    return color;
                }
                
                // If it's an rgb color, convert to hex
                if (color.startsWith('rgb(')) {
                    const matches = color.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
                    if (matches) {
                        const r = parseInt(matches[1]);
                        const g = parseInt(matches[2]);
                        const b = parseInt(matches[3]);
                        return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
                    }
                }
                
                // If it's transparent, return white
                if (color === 'transparent') {
                    return '#ffffff';
                }
                
                // Default fallback
                return '#000000';
            }
        }

