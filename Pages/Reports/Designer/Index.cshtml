                $('#prop-fieldName').val('');
                $('#prop-formatString').val('');
            }

            convertToHex(color) {
                if (!color) return '#000000';
                
                // If it's already a hex color, return it
                if (color.startsWith('#')) {
                    return color;
                }
                
                // If it's an rgb color, convert to hex
                if (color.startsWith('rgb(')) {
                    const matches = color.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
                    if (matches) {
                        const r = parseInt(matches[1]);
                        const g = parseInt(matches[2]);
                        const b = parseInt(matches[3]);
                        return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
                    }
                }
                
                // If it's transparent, return white
                if (color === 'transparent') {
                    return '#ffffff';
                }
                
                // Default fallback
                return '#000000';
            }

            // Data Binding Methods
            showDataBindingPanel(component) {
                console.log('Showing data binding panel for:', component);
                
                // Target the property content area, not the entire propertyGrid
                const panel = $(`#${this.panelId}`);
                const contentArea = panel.closest('.property-panel').find('.property-content');
                const actualPanel = contentArea.length > 0 ? contentArea : panel;
                actualPanel.empty();
                
                // Parse existing data binding
                let existingBinding = null;
                if (component.dataBinding) {
                    try {
                        existingBinding = JSON.parse(component.dataBinding);
                    } catch (e) {
                        console.error('Error parsing dataBinding:', e);
                    }
                }
                
                const tableName = existingBinding?.tableName || '';
                const fieldName = existingBinding?.fieldName || '';
                
                const html = `
                    <div class="property-section">
                        <h6 class="property-section-title"><i class="fas fa-database me-2"></i>Data Binding</h6>
                        
                        <div class="alert alert-info mb-3">
                            <small><strong>Current Binding:</strong> <span id="dataBindingPreview">${tableName && fieldName ? tableName + '.' + fieldName : 'None'}</span></small>
                        </div>
                        
                        <div class="property-group">
                            <label class="property-label">Select Data Source</label>
                            <select class="property-select" id="dataBindingTable">
                                <option value="">-- Select Table/View --</option>
                            </select>
                        </div>
                        
                        <div class="property-group" id="dataBindingFieldsGroup" style="display: none;">
                            <label class="property-label">Select Field</label>
                            <select class="property-select" id="dataBindingField">
                                <option value="">-- Select Field --</option>
                            </select>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button class="btn btn-success btn-sm flex-grow-1" id="dataBindingApplyBtn">
                                <i class="fas fa-check"></i> Apply
                            </button>
                            <button class="btn btn-secondary btn-sm" id="dataBindingClearBtn">
                                <i class="fas fa-times"></i> Clear
                            </button>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-outline-secondary btn-sm w-100" id="dataBindingCloseBtn">
                                <i class="fas fa-times"></i> Close
                            </button>
                        </div>
                    </div>
                `;
                
                actualPanel.html(html);
                
                // Load data sources
                this.loadDataSourcesForBinding(tableName, fieldName, component.id);
            }

            async loadDataSourcesForBinding(existingTable = '', existingField = '', componentId = '') {
                const tableSelect = $('#dataBindingTable');
                tableSelect.empty().append('<option value="">-- Loading tables...</option>');
                
                try {
                    // Fetch real database schema from the server
                    const response = await fetch('/Reports/Designer?handler=DatabaseSchema');
                    const tables = await response.json();
                    
                    tableSelect.empty().append('<option value="">-- Select Table/View --</option>');
                    
                    // Store schema for later use
                    this.databaseSchema = {};
                    
                    tables.forEach(table => {
                        const displayName = this.formatTableName(table.name);
                        const option = $(`<option value="${table.name}">${displayName}</option>`);
                        tableSelect.append(option);
                        
                        // Store columns for this table
                        this.databaseSchema[table.name] = table.columns || [];
                    });
                    
                    // Select existing binding if any
                    if (existingTable) {
                        tableSelect.val(existingTable);
                        this.loadFieldsForBinding(existingTable, existingField);
                    }
                } catch (error) {
                    console.error('Error loading database schema:', error);
                    tableSelect.empty().append('<option value="">-- Error loading tables --</option>');
                }
            }
            
            formatTableName(tableName) {
                // Convert "TableName" to "Table Name"
                return tableName.replace(/([A-Z])/g, ' $1').trim();
            }

            loadFieldsForBinding(tableName, existingField = '') {
                const fieldSelect = $('#dataBindingField');
                const fieldsGroup = $('#dataBindingFieldsGroup');
                
                fieldSelect.empty().append('<option value="">-- Select Field --</option>');
                
                if (!tableName) {
                    fieldsGroup.hide();
                    $('#dataBindingPreview').text('None');
                    return;
                }
                
                // Get columns from the loaded database schema
                const fields = this.databaseSchema?.[tableName] || [];
                
                fields.forEach(field => {
                    const fieldName = field.name || field;
                    const option = $(`<option value="${fieldName}">${fieldName}</option>`);
                    fieldSelect.append(option);
                });
                
                fieldsGroup.show();
                
                if (existingField) {
                    fieldSelect.val(existingField);
                    this.updateDataBindingPreview();
                }
            }

            updateDataBindingPreview() {
                const tableName = $('#dataBindingTable').val();
                const fieldName = $('#dataBindingField').val();
                
                if (tableName && fieldName) {
                    $('#dataBindingPreview').text(`${tableName}.${fieldName}`);
                } else {
                    $('#dataBindingPreview').text('None');
                }
            }
        }

        class DataSourceManager {
            constructor(treeId) {
                this.treeId = treeId;
                this.dataSources = [];
