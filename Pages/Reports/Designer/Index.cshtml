            function extractComponentsFromCanvas() {
                const components = [];
                const objects = window.fabricCanvas.canvas.getObjects();
                
                objects.forEach((obj, index) => {
                    if (obj.componentType) {
                        components.push({
                            id: obj.id || generateGuid(),
                            componentType: obj.componentType,
                            positionX: Math.round(obj.left),
                            positionY: Math.round(obj.top),
                            width: Math.round(obj.width * obj.scaleX),
                            height: Math.round(obj.height * obj.scaleY),
                            properties: JSON.stringify({
                                text: obj.text || '',
                                fontSize: obj.fontSize || 12,
                                fontFamily: obj.fontFamily || 'Arial',
                                fill: obj.fill || '#000000',
                                backgroundColor: obj.backgroundColor || 'transparent',
                                borderColor: obj.borderColor || 'transparent',
                                borderWidth: obj.borderWidth || 0,
                                rotation: obj.angle || 0,
                                opacity: obj.opacity || 1,
                                visible: obj.visible !== false
                            }),
                            dataBinding: obj.dataBinding ? JSON.stringify(obj.dataBinding) : null,
                            zIndex: obj.zIndex || index,
                            isVisible: obj.visible !== false
                        });
                    }
                });
                
                // Phase 7+: Also extract ExcelTable data (with binding info)
                if (window.excelTables) {
                    for (const [tableId, excelTable] of Object.entries(window.excelTables)) {
                        const tableData = excelTable.serialize();
                        components.push({
                            id: tableId,
                            componentType: 'table',
                            positionX: tableData.position.x,
                            positionY: tableData.position.y,
                            width: tableData.columns * tableData.cellWidth,
                            height: tableData.rows * tableData.cellHeight,
                            properties: JSON.stringify({
                                columns: tableData.columns,
                                rows: tableData.rows,
                                cellWidth: tableData.cellWidth,
                                cellHeight: tableData.cellHeight,
                                columnWidths: tableData.columnWidths,
                                rowHeights: tableData.rowHeights,
                                data: tableData.data
                            }),
                            dataBinding: excelTable.lastQuery ? JSON.stringify({ type: 'sql', sql: excelTable.lastQuery }) : null,
                            zIndex: 0,
                            isVisible: true
                        });
                    }
                }
                // Serialize overlay chart components
                if (window.charts) {
                    for (const [chartId, chart] of Object.entries(window.charts)) {
                        const props = chart.properties || {};
                        const bind = chart.dataBinding || null;
                        components.push({
                            id: chartId,
                            componentType: 'barChart',
                            positionX: Math.round(chart.position.x),
                            positionY: Math.round(chart.position.y),
                            width: Math.round(chart.size.width),
                            height: Math.round(chart.size.height),
                            properties: JSON.stringify(props),
                            dataBinding: bind ? JSON.stringify(bind) : null,
                            zIndex: 0,
                            isVisible: true
                        });
                    }
                }
                
                return components;
            }

