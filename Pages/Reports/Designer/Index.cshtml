                              <div id="cb-preview" class="mt-3" style="max-height:240px; overflow:auto; display:none"></div>
                            </div>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                          <button type="button" class="btn btn-outline-primary" id="cb-test">Preview</button>
                          <button type="button" class="btn btn-success" id="cb-save">Save Binding</button>
                        </div>
                      </div>
                    </div>
                  </div>`);

                $('body').append(dialog);
                const $sql = dialog.find('#cb-sql');
                const $err = dialog.find('#cb-error');
                const $prev = dialog.find('#cb-preview');
                const $table = dialog.find('#cb-table');
                const $x = dialog.find('#cb-x');
                const $yList = dialog.find('#cb-y-list');
                const $series = dialog.find('#cb-series');
                const $agg = dialog.find('#cb-agg');

                $sql.val(existing.sql || '');

                dialog.modal('show');
                dialog.on('hidden.bs.modal', () => dialog.remove());

                dialog.find('#cb-load').on('click', async () => {
                    try {
                        const res = await fetch('/api/ReportWizard/data/schema');
                        const json = await res.json();
                        if (!json.success) throw new Error(json.error || 'Load schema failed');
                        const tables = json.tables || [];
                        $table.empty().append('<option value="">-- select --</option>');
                        tables.forEach(t=> $table.append(`<option value="${t.name}">${t.name}</option>`));
                    } catch (e) {
                        $err.text(String(e.message || e)).show();
                    }
                });

                $table.on('change', () => {
                    const tbl = $table.val();
                    if (!tbl) return;
                    // find selected table columns by reusing previously fetched schema in json (quick fetch again)
                    fetch('/api/ReportWizard/data/schema').then(r=>r.json()).then(json => {
                        const t = (json.tables||[]).find(x=>x.name===tbl);
                        if (!t) return;
                        $x.empty();
                        $series.empty().append('<option value="">(none)</option>');
                        $yList.empty();
                        (t.columns||[]).forEach(c=>{
                            $x.append(`<option value="${c.name}">${c.name}</option>`);
                            $series.append(`<option value="${c.name}">${c.name}</option>`);
                            const id = `cb-y-${c.name}`;
                            $yList.append(`<div class="form-check"><input class="form-check-input" type="checkbox" id="${id}" data-col="${c.name}"><label class="form-check-label" for="${id}">${c.name}</label></div>`);
                        });
                    });
                });

                dialog.find('#cb-gen').on('click', () => {
                    const tbl = $table.val();
                    const xField = $x.val();
                    const seriesField = $series.val();
                    const yFields = [];
                    $yList.find('input[type=checkbox]:checked').each(function(){ yFields.push($(this).data('col')); });
                    if (!tbl || !xField || yFields.length === 0) { $err.text('Pick table, xField, and at least one yField.').show(); return; }
                    const agg = $agg.val();
                    const selectParts = [`[${xField}]`];
                    if (seriesField) selectParts.push(`[${seriesField}]`);
                    yFields.forEach(y=> selectParts.push(`${agg.toUpperCase()}([${y}]) AS [${y}]`));
                    const groupBy = seriesField ? `[${xField}], [${seriesField}]` : `[${xField}]`;
                    const sql = `SELECT ${selectParts.join(', ')} FROM ${tbl} GROUP BY ${groupBy} ORDER BY [${xField}]`;
                    $sql.val(sql);
                    $err.hide();
                });

                dialog.find('#cb-test').on('click', async () => {
                    $err.hide().text('');
                    $prev.hide().empty();
                    try {
                        const res = await fetch('/api/chart/preview', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ dataBinding: { type: 'sql', sql: $sql.val() }, maxRows: 500 })
                        });
                        const json = await res.json();
                        if (!json.success) throw new Error(json.error || 'Preview failed');
                        const cols = json.columns || [];
                        const rows = json.rows || [];
                        let html = '<table class="table table-sm"><thead><tr>' + cols.map(c=>`<th>${c}</th>`).join('') + '</tr></thead><tbody>';
                        rows.forEach(r=>{ html += '<tr>' + cols.map(c=>`<td>${r[c] ?? ''}</td>`).join('') + '</tr>'; });
                        html += '</tbody></table>';
                        $prev.html(html).show();
                    } catch (e) {
                        $err.text(String(e.message || e)).show();
                    }
                });

                dialog.find('#cb-save').on('click', () => {
                    // Derive mapping from current selections
                    const xField = $x.val();
                    const seriesField = $series.val() || null;
                    const yFields = [];
                    $yList.find('input[type=checkbox]:checked').each(function(){ yFields.push($(this).data('col')); });
                    const bind = { type: 'sql', sql: $sql.val(), mapping: { xField, yFields, seriesField } };
                    chart.dataBinding = bind;
                    chart.refresh();
                    dialog.modal('hide');
                });
            }

            function showReportPreviewDialog(preview) {
                const html = (preview && preview.htmlContent) ? preview.htmlContent : `<!doctype html>
