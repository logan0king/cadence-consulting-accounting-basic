                const canvas = window.fabricCanvas.canvas;
                
                // Enable drop on canvas
                canvas.wrapperEl.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'copy';
                });

                canvas.wrapperEl.addEventListener('drop', function(e) {
                    e.preventDefault();
                    
                    try {
                        const data = JSON.parse(e.dataTransfer.getData('text/plain'));
                        
                        if (data.type === 'field') {
                            // Get canvas coordinates
                            const pointer = canvas.getPointer(e);
                            
                            // Create a text field for the dropped field
                            const textField = new fabric.Textbox(data.name, {
                                left: pointer.x,
                                top: pointer.y,
                                width: 150,
                                height: 30,
                                fontSize: 12,
                                fill: '#007bff',
                                padding: 5,
                                borderColor: '#cccccc',
                                borderWidth: 1
                            });
                            
                            // Add custom properties to identify this as a data field
                            textField.set({
                                fieldType: data.fieldType,
                                sourceName: data.sourceName,
                                componentType: 'field'
                            });
                            
                            canvas.add(textField);
                            canvas.renderAll();
                            
                            // Update save button state when object is added
                            console.log('Field dropped on canvas, updating save button state');
                            if (typeof updateSaveButtonState === 'function') {
                                window.updateSaveButtonState();
                            }
                        }
                    } catch (error) {
                        console.error('Error handling drop:', error);
                    }
                });
