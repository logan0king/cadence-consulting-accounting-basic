            // Missing functions that are called by event handlers
            async function generateSql() {
                const reportId = getCurrentReportId();
                if (!reportId) {
                    alert('No report selected. Please create or load a report first.');
                    return;
                }

                try {
                    showLoadingDialog('Generating SQL...');
                    
                    const response = await fetch(`?handler=GenerateSql&reportId=${reportId}`);
                    const result = await response.json();
                    
                    hideLoadingDialog();
                    
                    if (result.success) {
                        showSqlDialog(result.sql);
                    } else {
                        alert('Error generating SQL: ' + result.error);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    alert('Error generating SQL: ' + error.message);
                }
            }

            async function executeReport() {
                const reportId = getCurrentReportId();
                if (!reportId) {
                    alert('No report selected. Please create or load a report first.');
                    return;
                }

                try {
                    // Auto-refresh bound tables first
                    showLoadingDialog('Refreshing data...');
                    if (window.excelTables) {
                        const refreshPromises = Object.values(window.excelTables).map(t => t.refreshFromSql && t.refreshFromSql());
                        await Promise.all(refreshPromises);
                    }
                    hideLoadingDialog();

                    // Use the same renderer as Preview so the full report layout is shown
                    showLoadingDialog('Executing report...');
                    const response = await fetch(`?handler=PreviewReport&reportId=${reportId}`);
                    const result = await response.json();
                    hideLoadingDialog();
                    if (result.success && result.preview && result.preview.htmlContent) {
                        showReportPreviewDialog(result.preview);
                    } else {
                        const payload = typeof result === 'object' ? JSON.stringify(result, null, 2) : String(result);
                        alert('Execute returned no content. Details: ' + payload);
                    }
                } catch (error) {
                    hideLoadingDialog();
                    alert('Error executing report: ' + error.message);
                }
            }

            async function downloadPdf() {
                const reportId = getCurrentReportId();
                if (!reportId) {
                    alert('No report selected. Please create or load a report first.');
                    return;
                }

                try {
                    showLoadingDialog('Generating PDF file...');
                    
                    const response = await fetch(`?handler=ExportPdf&reportId=${reportId}`);
                    
                    if (response.ok) {
                        const blob = await response.blob();
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `report_${reportId}.pdf`;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                    } else {
                        const result = await response.json();
                        alert('Error generating PDF: ' + result.error);
                    }
                    
                    hideLoadingDialog();
                } catch (error) {
