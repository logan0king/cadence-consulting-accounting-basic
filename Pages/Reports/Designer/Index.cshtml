@section Styles {
    <link rel="stylesheet" href="~/css/report-designer.css" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/ui-lightness/jquery-ui.css">
}

@section Scripts {
    <script src="~/lib/fabric.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <!-- External JavaScript files will be loaded inline below -->
    <script>
        // Core Classes
            class FabricCanvasManager {
                constructor(canvasId) {
                    this.canvasId = canvasId;
                    this.currentPaperSize = 'letter';
                    this.paperSizes = {
                        'letter': { width: 612, height: 792, name: 'Letter (8.5" × 11")' },
                        'legal': { width: 612, height: 1008, name: 'Legal (8.5" × 14")' },
                        'a4': { width: 595, height: 842, name: 'A4 (210 × 297mm)' },
                        'a3': { width: 842, height: 1191, name: 'A3 (297 × 420mm)' },
                        'tabloid': { width: 792, height: 1224, name: 'Tabloid (11" × 17")' },
                        'custom': { width: 800, height: 600, name: 'Custom' }
                    };
                    
                    this.canvas = new fabric.Canvas(canvasId, {
                        width: this.paperSizes[this.currentPaperSize].width,
                        height: this.paperSizes[this.currentPaperSize].height,
                        backgroundColor: '#ffffff'
                    });
                    this.propertyGrid = null;
                    this.setupEventHandlers();
                    this.setupPaperSizeHandlers();
                    this.setupResizeHandlers();
                    this.setupZoomHandlers();
                    this.setupGridHandlers();
                    this.setupBackgroundHandlers();
                    
                    // Initialize background layer
                    this.updateBackgroundLayerSize();
                    this.setCanvasBackground('white'); // Set default background
                }

            setPropertyGrid(propertyGrid) {
                this.propertyGrid = propertyGrid;
            }

                setupEventHandlers() {
                    this.canvas.on('selection:created', (e) => {
                        if (this.propertyGrid) {
                            this.propertyGrid.updateProperties(e.selected[0]);
                        }
                    });

                    this.canvas.on('selection:updated', (e) => {
                        if (this.propertyGrid) {
                            this.propertyGrid.updateProperties(e.selected[0]);
                        }
                    });

                    this.canvas.on('selection:cleared', () => {
                        if (this.propertyGrid) {
                            this.propertyGrid.clearProperties();
                        }
                    });
                }

                setupPaperSizeHandlers() {
                    $('#paperSize').on('change', (e) => {
                        const paperSize = e.target.value;
                        this.setPaperSize(paperSize);
                    });
                }

                setupResizeHandlers() {
                    let isResizing = false;
                    let startX, startY, startWidth, startHeight;

                    $('#canvasResizeHandle').on('mousedown', (e) => {
                        isResizing = true;
                        startX = e.clientX;
                        startY = e.clientY;
                        startWidth = this.canvas.width;
                        startHeight = this.canvas.height;
                        
                        e.preventDefault();
                        e.stopPropagation();
                    });

                    $(document).on('mousemove', (e) => {
                        if (!isResizing) return;
                        
                        const deltaX = e.clientX - startX;
                        const deltaY = e.clientY - startY;
                        
                        const newWidth = Math.max(400, startWidth + deltaX);
                        const newHeight = Math.max(300, startHeight + deltaY);
                        
                        this.resizeCanvas(newWidth, newHeight);
                    });

                    $(document).on('mouseup', () => {
                        isResizing = false;
                    });
                }

                setPaperSize(paperSize) {
                    this.currentPaperSize = paperSize;
                    const size = this.paperSizes[paperSize];
                    
                    if (paperSize === 'custom') {
                        // For custom, allow user to resize manually
                        this.resizeCanvas(800, 600);
                    } else {
                        this.resizeCanvas(size.width, size.height);
                    }
                    
                    // Update the paper size selector if it's not already set
                    if ($('#paperSize').val() !== paperSize) {
                        $('#paperSize').val(paperSize);
                    }
                }

                resizeCanvas(width, height) {
                    this.canvas.setDimensions({
                        width: width,
                        height: height
                    });
                    this.canvas.renderAll();
                    
                    // Update custom paper size if selected
                    if (this.currentPaperSize === 'custom') {
                        this.paperSizes.custom.width = width;
                        this.paperSizes.custom.height = height;
                    }
                    
                    // Update canvas wrapper size to accommodate new canvas size
                    this.updateCanvasWrapperSize();
                    
                    // Update background layer size to match canvas
                    this.updateBackgroundLayerSize();
                }

                updateCanvasWrapperSize() {
                    const canvasWrapper = $('.canvas-wrapper');
                    const padding = 20; // Account for margins and padding
                    const newWidth = Math.min(this.canvas.width + padding, $(window).width() - 600); // 600px for sidebars
                    const newHeight = Math.min(this.canvas.height + padding, $(window).height() - 200); // 200px for header/toolbar
                    
                    canvasWrapper.css({
                        'width': newWidth + 'px',
                        'height': newHeight + 'px',
                        'max-width': '100%',
                        'max-height': '100%'
                    });
                }

                toggleGrid() {
                    // Toggle grid visibility
                    if (this.canvas.grid) {
                        this.canvas.grid = false;
                    } else {
                        this.canvas.grid = true;
                    }
                    this.canvas.renderAll();
                }

                setGridSize(size) {
                    this.canvas.gridSize = size;
                    this.canvas.renderAll();
                }

                setupZoomHandlers() {
                    let zoomLevel = 1;
                    
                    $('#zoomIn').on('click', () => {
                        zoomLevel = Math.min(zoomLevel * 1.2, 5);
                        this.setZoom(zoomLevel);
                    });
                    
                    $('#zoomOut').on('click', () => {
                        zoomLevel = Math.max(zoomLevel / 1.2, 0.1);
                        this.setZoom(zoomLevel);
                    });
                    
                    $('#resetZoom').on('click', () => {
                        zoomLevel = 1;
                        this.setZoom(zoomLevel);
                    });
                }

                setZoom(level) {
                    this.canvas.setZoom(level);
                    $('#zoomLevel').text(Math.round(level * 100) + '%');
                }

                setupGridHandlers() {
                    $('#toggleGrid').on('click', () => {
                        this.toggleGrid();
                    });
                    
                    $('#gridSize').on('change', (e) => {
                        this.setGridSize(parseInt(e.target.value));
                    });
                }

                setupBackgroundHandlers() {
                    $('#canvasBackground').on('change', (e) => {
                        this.setCanvasBackground(e.target.value);
                    });
                }

                setCanvasBackground(backgroundType) {
                    const backgroundLayer = $('#canvasBackgroundLayer');
                    console.log('Setting background to:', backgroundType);
                    console.log('Background layer found:', backgroundLayer.length);
                    
                    // Remove existing background classes
                    backgroundLayer.removeClass('graph-paper');
                    
                    // Set new background
                    switch (backgroundType) {
                        case 'white':
                            backgroundLayer.css({
                                'background-color': '#ffffff',
                                'background-image': 'none',
                                'display': 'block'
                            });
                            break;
                        case 'graph':
                            // Create graph paper using a data URL for better compatibility
                            const gridSize = 20;
                            const canvas = document.createElement('canvas');
                            canvas.width = gridSize;
                            canvas.height = gridSize;
                            const ctx = canvas.getContext('2d');
                            
                            // Draw grid lines
                            ctx.strokeStyle = 'rgba(0,0,0,0.2)';
                            ctx.lineWidth = 1;
                            
                            // Vertical line
                            ctx.beginPath();
                            ctx.moveTo(gridSize, 0);
                            ctx.lineTo(gridSize, gridSize);
                            ctx.stroke();
                            
                            // Horizontal line
                            ctx.beginPath();
                            ctx.moveTo(0, gridSize);
                            ctx.lineTo(gridSize, gridSize);
                            ctx.stroke();
                            
                            const dataURL = canvas.toDataURL();
                            
                            backgroundLayer.css({
                                'background-color': '#ffffff',
                                'background-image': `url(${dataURL})`,
                                'background-size': `${gridSize}px ${gridSize}px`,
                                'background-position': '0 0',
                                'background-repeat': 'repeat',
                                'display': 'block'
                            });
                            break;
                    }
                    
                    // Update background layer size to match canvas
                    this.updateBackgroundLayerSize();
                    console.log('Background layer size:', backgroundLayer.css('width'), 'x', backgroundLayer.css('height'));
                    console.log('Background image:', backgroundLayer.css('background-image'));
                }

                updateBackgroundLayerSize() {
                    const backgroundLayer = $('#canvasBackgroundLayer');
                    backgroundLayer.css({
                        'width': this.canvas.width + 'px',
                        'height': this.canvas.height + 'px'
                    });
                }

                getCurrentPaperSize() {
                    return {
                        name: this.paperSizes[this.currentPaperSize].name,
                        width: this.canvas.width,
                        height: this.canvas.height
                    };
                }

            addReportComponent(type, options = {}) {
                console.log('addReportComponent called with type:', type);
                let component;
                const defaultOptions = {
                    left: 50,
                    top: 50,
                    ...options
                };

                switch (type) {
                    case 'textbox':
                        component = new fabric.Textbox(options.text || 'Text', {
                            ...defaultOptions,
                            width: options.width || 200,
                            height: options.height || 50,
                            fontSize: options.fontSize || 14,
                            fill: options.fill || '#000000'
                        });
                        break;
                    case 'rectangle':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 200,
                            height: options.height || 100,
                            fill: options.fill || 'transparent',
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 1
                        });
                        break;
                    case 'line':
                        component = new fabric.Line([0, 0, options.width || 200, 0], {
                            ...defaultOptions,
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 1
                        });
                        break;
                    case 'table':
                        component = new fabric.Textbox('Table\nRow 1\nRow 2', {
                            ...defaultOptions,
                            width: options.width || 300,
                            height: options.height || 100,
                            fontSize: options.fontSize || 12
                        });
                        break;
                    case 'chart':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 300,
                            height: options.height || 200,
                            fill: options.fill || '#f0f0f0',
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 1
                        });
                        break;
                    case 'checkbox':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 20,
                            height: options.height || 20,
                            fill: options.fill || '#ffffff',
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 2
                        });
                        // Add checkmark if checked
                        if (options.checked) {
                            const checkmark = new fabric.Text('✓', {
                                left: 2,
                                top: -2,
                                fontSize: 16,
                                fill: '#000000'
                            });
                            component.addWithUpdate(checkmark);
                        }
                        break;
                    case 'richtext':
                        component = new fabric.Textbox(options.text || 'Rich Text', {
                            ...defaultOptions,
                            width: options.width || 200,
                            height: options.height || 100,
                            fontSize: options.fontSize || 14,
                            fill: options.fill || '#000000',
                            fontStyle: options.fontStyle || 'normal',
                            fontWeight: options.fontWeight || 'normal',
                            textDecoration: options.textDecoration || 'none'
                        });
                        break;
                    case 'picturebox':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 150,
                            height: options.height || 100,
                            fill: options.fill || '#f8f9fa',
                            stroke: options.stroke || '#dee2e6',
                            strokeWidth: options.strokeWidth || 1,
                            strokeDashArray: [5, 5]
                        });
                        // Add image placeholder text
                        const imageText = new fabric.Text('Image', {
                            left: 0,
                            top: 0,
                            width: options.width || 150,
                            height: options.height || 100,
                            fontSize: 12,
                            fill: '#6c757d',
                            textAlign: 'center',
                            originX: 'center',
                            originY: 'center'
                        });
                        component.addWithUpdate(imageText);
                        break;
                    case 'shape':
                        const shapeType = options.shapeType || 'rectangle';
                        switch (shapeType) {
                            case 'circle':
                                component = new fabric.Circle({
                                    ...defaultOptions,
                                    radius: (options.width || 50) / 2,
                                    fill: options.fill || 'transparent',
                                    stroke: options.stroke || '#000000',
                                    strokeWidth: options.strokeWidth || 1
                                });
                                break;
                            case 'triangle':
                                component = new fabric.Triangle({
                                    ...defaultOptions,
                                    width: options.width || 100,
                                    height: options.height || 100,
                                    fill: options.fill || 'transparent',
                                    stroke: options.stroke || '#000000',
                                    strokeWidth: options.strokeWidth || 1
                                });
                                break;
                            case 'ellipse':
                                component = new fabric.Ellipse({
                                    ...defaultOptions,
                                    rx: (options.width || 100) / 2,
                                    ry: (options.height || 60) / 2,
                                    fill: options.fill || 'transparent',
                                    stroke: options.stroke || '#000000',
                                    strokeWidth: options.strokeWidth || 1
                                });
                                break;
                            default: // rectangle
                                component = new fabric.Rect({
                                    ...defaultOptions,
                                    width: options.width || 100,
                                    height: options.height || 60,
                                    fill: options.fill || 'transparent',
                                    stroke: options.stroke || '#000000',
                                    strokeWidth: options.strokeWidth || 1
                                });
                        }
                        break;
                    case 'barcode':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 200,
                            height: options.height || 50,
                            fill: options.fill || '#ffffff',
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 1
                        });
                        // Add barcode pattern simulation
                        const barcodeText = new fabric.Text('||||||||||||||||||||', {
                            left: 0,
                            top: 0,
                            width: options.width || 200,
                            height: options.height || 50,
                            fontSize: 8,
                            fill: '#000000',
                            textAlign: 'center',
                            originX: 'center',
                            originY: 'center'
                        });
                        component.addWithUpdate(barcodeText);
                        break;
                    case 'gauge':
                        component = new fabric.Circle({
                            ...defaultOptions,
                            radius: (options.width || 100) / 2,
                            fill: options.fill || '#f8f9fa',
                            stroke: options.stroke || '#007bff',
                            strokeWidth: options.strokeWidth || 8,
                            startAngle: 0,
                            endAngle: Math.PI * 2 * (options.value || 0.75)
                        });
                        // Add gauge value text
                        const gaugeText = new fabric.Text(`${Math.round((options.value || 0.75) * 100)}%`, {
                            left: 0,
                            top: 0,
                            fontSize: 16,
                            fill: '#000000',
                            textAlign: 'center',
                            originX: 'center',
                            originY: 'center'
                        });
                        component.addWithUpdate(gaugeText);
                        break;
                    case 'sparkline':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 150,
                            height: options.height || 30,
                            fill: options.fill || '#ffffff',
                            stroke: options.stroke || '#007bff',
                            strokeWidth: options.strokeWidth || 2
                        });
                        // Add sparkline pattern
                        const sparklineText = new fabric.Text('📈', {
                            left: 0,
                            top: 0,
                            width: options.width || 150,
                            height: options.height || 30,
                            fontSize: 20,
                            fill: '#28a745',
                            textAlign: 'center',
                            originX: 'center',
                            originY: 'center'
                        });
                        component.addWithUpdate(sparklineText);
                        break;
                    case 'pivotgrid':
                        component = new fabric.Textbox('Pivot Grid\nRow 1 | Col 1 | Col 2\nRow 2 | Col 1 | Col 2', {
                            ...defaultOptions,
                            width: options.width || 300,
                            height: options.height || 120,
                            fontSize: options.fontSize || 12,
                            fill: options.fill || '#000000'
                        });
                        break;
                    case 'tableofcontents':
                        component = new fabric.Textbox('Table of Contents\n1. Section One\n2. Section Two\n3. Section Three', {
                            ...defaultOptions,
                            width: options.width || 200,
                            height: options.height || 100,
                            fontSize: options.fontSize || 12,
                            fill: options.fill || '#000000'
                        });
                        break;
                    case 'pageinfo':
                        component = new fabric.Textbox('Page 1 of 10\nDate: [Current Date]', {
                            ...defaultOptions,
                            width: options.width || 150,
                            height: options.height || 40,
                            fontSize: options.fontSize || 10,
                            fill: options.fill || '#6c757d',
                            textAlign: options.textAlign || 'right'
                        });
                        break;
                    case 'crossbandline':
                        component = new fabric.Line([0, 0, options.width || 300, 0], {
                            ...defaultOptions,
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 2,
                            strokeDashArray: options.strokeDashArray || [5, 5]
                        });
                        break;
                    case 'crossbandbox':
                        component = new fabric.Rect({
                            ...defaultOptions,
                            width: options.width || 300,
                            height: options.height || 20,
                            fill: options.fill || 'transparent',
                            stroke: options.stroke || '#000000',
                            strokeWidth: options.strokeWidth || 1,
                            strokeDashArray: [3, 3]
                        });
                        break;
                    default:
                        component = new fabric.Textbox('Component', {
                            ...defaultOptions,
                            width: 100,
                            height: 50
                        });
                }

                component.componentType = type;
                this.canvas.add(component);
                this.canvas.setActiveObject(component);
                this.canvas.renderAll();
                
                // Update save button state when object is added
                console.log('Object added to canvas, updating save button state');
                if (typeof window.updateSaveButtonState === 'function') {
                    window.updateSaveButtonState();
                } else {
                    console.log('updateSaveButtonState function not found');
                }
                
                return component;
            }
        }

