@page
@model CadenceAccounting.Pages.Reports.ManageModel
@{
    ViewData["Title"] = "Manage Reports";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="fas fa-cogs me-2"></i>Manage Reports</h2>
                    <p class="text-muted">View, edit, and delete report definitions in the system.</p>
                </div>
                <div>
                    <a href="/Reports/Designer" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Create New Report
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Reports Grid -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Report Definitions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>Group</th>
                                    <th>Created By</th>
                                    <th>Created</th>
                                    <th>Updated</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewData["Reports"] != null)
                                {
                                    var reportsToDisplay = ViewData["Reports"] as List<CadenceAccounting.Models.ReportDefinition>;
                                    @if (reportsToDisplay?.Any() == true)
                                    {
                                        @foreach (var report in reportsToDisplay)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@report.Title</strong>
                                                    @if (report.IsTemplate)
                                                    {
                                                        <span class="badge bg-info ms-1">Template</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(report.Description))
                                                    {
                                                        <span class="text-muted">@(report.Description.Length > 50 ? report.Description.Substring(0, 50) + "..." : report.Description)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No description</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary">@report.ReportGroup</span>
                                                </td>
                                                <td>@report.CreatedByUser?.Username</td>
                                                <td>@report.CreatedAt.ToString("MMM dd, yyyy")</td>
                                                <td>@report.UpdatedAt.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    @if (report.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a href="/Reports/Designer?reportId=@report.Id" class="btn btn-sm btn-outline-primary" title="Edit Report">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                                onclick="confirmDelete('@report.Id', '@report.Title')" title="Delete Report">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-4">
                                                <div class="text-muted">
                                                    <i class="fas fa-file-alt fa-2x mb-2"></i>
                                                    <p class="mb-2">No reports found</p>
                                                    <a href="/Reports/Designer" class="btn btn-primary btn-sm">
                                                        <i class="fas fa-plus me-1"></i>Create New Report
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="fas fa-file-alt fa-2x mb-2"></i>
                                                <p class="mb-2">No reports found</p>
                                                <a href="/Reports/Designer" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-plus me-1"></i>Create New Report
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the report <strong id="reportTitleToDelete"></strong>?</p>
                <p class="text-danger"><small>This action cannot be undone.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Report</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden delete form -->
<form id="deleteForm" method="post" asp-page-handler="Delete" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="reportIdToDelete" name="reportId" />
</form>

@section Scripts {
    <script>
        console.log('Manage reports page JavaScript loaded');
        
                // Add event listener for the confirm delete button
                document.addEventListener('DOMContentLoaded', function() {
                    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
                    if (confirmDeleteBtn) {
                        confirmDeleteBtn.addEventListener('click', function(event) {
                            console.log('Confirm delete button clicked');
                            event.preventDefault(); // Prevent any default behavior
                            event.stopPropagation(); // Stop event bubbling
                            submitDelete();
                            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                        });
                    }
                });
        
        function confirmDelete(reportId, reportTitle) {
            console.log('confirmDelete called with:', reportId, reportTitle);
            document.getElementById('reportIdToDelete').value = reportId;
            document.getElementById('reportTitleToDelete').textContent = reportTitle;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
        
        function submitDelete() {
            console.log('submitDelete called');
            var form = document.getElementById('deleteForm');
            var reportId = document.getElementById('reportIdToDelete').value;
            console.log('Report ID to delete:', reportId);
            console.log('Form found:', form);
            
            if (!form) {
                console.error('Delete form not found');
                return;
            }
            
            if (!reportId) {
                console.error('Report ID not found');
                return;
            }
            
            console.log('Submitting delete form...');
            console.log('Form action:', form.action);
            console.log('Form method:', form.method);
            
            // Use fetch to submit the form and see the response
            const formData = new FormData(form);
            console.log('Form data:', Object.fromEntries(formData));
            
            // Add the handler parameter to the URL
            const url = form.action + '?handler=Delete';
            console.log('Fetch URL:', url);
            
            fetch(url, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                console.log('Response status:', response.status);
                console.log('Response ok:', response.ok);
                if (response.ok) {
                    console.log('Delete successful, reloading page in 10 seconds...');
                    setTimeout(() => {
                        window.location.reload();
                    }, 10000);
                } else {
                    console.error('Delete failed with status:', response.status);
                }
            })
            .catch(error => {
                console.error('Delete error:', error);
            });
            
            // Close the modal
            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
        }
    </script>
}
