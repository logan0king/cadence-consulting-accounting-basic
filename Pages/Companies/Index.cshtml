@page
@model CadenceAccounting.Pages.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-building me-2"></i>
                    Companies
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCompanyModal">
                    <i class="fas fa-plus me-2"></i>
                    Add Company
                </button>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Companies Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Companies</h5>
                </div>
                <div class="card-body">
                    @if (Model.Companies.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Company Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>City, State</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in Model.Companies)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@company.Name</strong>
                                            </td>
                                            <td>@company.Email</td>
                                            <td>@company.Phone</td>
                                            <td>@company.City, @company.State</td>
                                            <td>@company.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary me-1" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#editCompanyModal"
                                                        data-company-id="@company.Id"
                                                        data-company-name="@company.Name"
                                                        data-company-email="@company.Email"
                                                        data-company-phone="@company.Phone"
                                                        data-company-address="@company.Address"
                                                        data-company-city="@company.City"
                                                        data-company-state="@company.State"
                                                        data-company-zipcode="@company.ZipCode"
                                                        data-company-taxid="@company.TaxId"
                                                        title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form method="post" action="?handler=Delete&id=@company.Id" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                            onclick="return confirm('Are you sure you want to delete this company?')" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-building fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No Companies Found</h5>
                            <p class="text-muted">Get started by adding your first company.</p>
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCompanyModal">
                                <i class="fas fa-plus me-2"></i>
                                Add Company
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Company Modal -->
<div class="modal fade" id="createCompanyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>
                    Add Company
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="?handler=Create">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.Name" class="form-label">Company Name</label>
                            <input name="Input.Name" class="form-control" placeholder="Enter company name..." required />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.Email" class="form-label">Email</label>
                            <input name="Input.Email" type="email" class="form-control" placeholder="Enter email..." />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.Phone" class="form-label">Phone</label>
                            <input name="Input.Phone" class="form-control" placeholder="Enter phone number..." />
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.TaxId" class="form-label">Tax ID</label>
                            <input name="Input.TaxId" class="form-control" placeholder="Enter tax ID..." />
                            <span asp-validation-for="Input.TaxId" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Input.Address" class="form-label">Address</label>
                        <input name="Input.Address" class="form-control" placeholder="Enter street address..." />
                        <span asp-validation-for="Input.Address" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="Input.City" class="form-label">City</label>
                            <input name="Input.City" class="form-control" placeholder="Enter city..." />
                            <span asp-validation-for="Input.City" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Input.State" class="form-label">State</label>
                            <input name="Input.State" class="form-control" placeholder="Enter state..." />
                            <span asp-validation-for="Input.State" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Input.ZipCode" class="form-label">Zip Code</label>
                            <input name="Input.ZipCode" class="form-control" placeholder="Enter zip code..." />
                            <span asp-validation-for="Input.ZipCode" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Add Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Company Modal -->
<div class="modal fade" id="editCompanyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-edit me-2"></i>
                    Edit Company
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="?handler=Edit" id="editCompanyForm">
                <div class="modal-body">
                    <input type="hidden" name="EditInput.Id" id="editCompanyId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="EditInput.Name" class="form-label">Company Name</label>
                            <input name="EditInput.Name" id="editCompanyName" class="form-control" placeholder="Enter company name..." required />
                            <span asp-validation-for="EditInput.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="EditInput.Email" class="form-label">Email</label>
                            <input name="EditInput.Email" id="editCompanyEmail" type="email" class="form-control" placeholder="Enter email..." />
                            <span asp-validation-for="EditInput.Email" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="EditInput.Phone" class="form-label">Phone</label>
                            <input name="EditInput.Phone" id="editCompanyPhone" class="form-control" placeholder="Enter phone number..." />
                            <span asp-validation-for="EditInput.Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="EditInput.TaxId" class="form-label">Tax ID</label>
                            <input name="EditInput.TaxId" id="editCompanyTaxId" class="form-control" placeholder="Enter tax ID..." />
                            <span asp-validation-for="EditInput.TaxId" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="EditInput.Address" class="form-label">Address</label>
                        <input name="EditInput.Address" id="editCompanyAddress" class="form-control" placeholder="Enter street address..." />
                        <span asp-validation-for="EditInput.Address" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="EditInput.City" class="form-label">City</label>
                            <input name="EditInput.City" id="editCompanyCity" class="form-control" placeholder="Enter city..." />
                            <span asp-validation-for="EditInput.City" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="EditInput.State" class="form-label">State</label>
                            <input name="EditInput.State" id="editCompanyState" class="form-control" placeholder="Enter state..." />
                            <span asp-validation-for="EditInput.State" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="EditInput.ZipCode" class="form-label">Zip Code</label>
                            <input name="EditInput.ZipCode" id="editCompanyZipCode" class="form-control" placeholder="Enter zip code..." />
                            <span asp-validation-for="EditInput.ZipCode" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Update Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Handle edit modal data population
        document.getElementById('editCompanyModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var companyId = button.getAttribute('data-company-id');
            var companyName = button.getAttribute('data-company-name');
            var companyEmail = button.getAttribute('data-company-email');
            var companyPhone = button.getAttribute('data-company-phone');
            var companyAddress = button.getAttribute('data-company-address');
            var companyCity = button.getAttribute('data-company-city');
            var companyState = button.getAttribute('data-company-state');
            var companyZipCode = button.getAttribute('data-company-zipcode');
            var companyTaxId = button.getAttribute('data-company-taxid');

            document.getElementById('editCompanyId').value = companyId;
            document.getElementById('editCompanyName').value = companyName;
            document.getElementById('editCompanyEmail').value = companyEmail;
            document.getElementById('editCompanyPhone').value = companyPhone;
            document.getElementById('editCompanyAddress').value = companyAddress;
            document.getElementById('editCompanyCity').value = companyCity;
            document.getElementById('editCompanyState').value = companyState;
            document.getElementById('editCompanyZipCode').value = companyZipCode;
            document.getElementById('editCompanyTaxId').value = companyTaxId;
        });

        // Set form action for edit
        document.getElementById('editCompanyForm').action = '?handler=Edit';
    </script>
}
