@page
@model CadenceAccounting.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Invoices";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-file-invoice me-2"></i>
                    Invoices
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">
                    <i class="fas fa-plus me-2"></i>
                    Create Invoice
                </button>
            </div>

            <!-- Invoices Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Invoices</h5>
                </div>
                <div class="card-body">
                    @if (Model.Invoices.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Invoice #</th>
                                        <th>Project</th>
                                        <th>Client</th>
                                        <th>Date</th>
                                        <th>Due Date</th>
                                        <th>Amount</th>
                                        <th>Paid</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.Invoices)
                                    {
                                        <tr>
                                            <td>
                                                <a href="/Invoices/Details/@invoice.Id" class="text-decoration-none fw-bold">
                                                    @invoice.InvoiceNumber
                                                </a>
                                            </td>
                                            <td>@invoice.Project.Name</td>
                                            <td>@invoice.Project.ClientName</td>
                                            <td>@invoice.InvoiceDate.ToString("MM/dd/yyyy")</td>
                                            <td>@invoice.DueDate.ToString("MM/dd/yyyy")</td>
                                            <td>@invoice.TotalAmount.ToString("C")</td>
                                            <td>@invoice.TotalPaid.ToString("C")</td>
                                            <td>
                                                @if (invoice.IsPaid)
                                                {
                                                    <span class="badge bg-success">Paid</span>
                                                }
                                                else if (invoice.DueDate < DateTime.Today)
                                                {
                                                    <span class="badge bg-danger">Overdue</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">@invoice.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/Invoices/Details/@invoice.Id" class="btn btn-outline-primary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/Invoices/Pdf/@invoice.Id" class="btn btn-outline-secondary" title="Download PDF" target="_blank">
                                                        <i class="fas fa-file-pdf"></i>
                                                    </a>
                                                    <form method="post" asp-page-handler="SendEmail" asp-route-id="@invoice.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-info" title="Send Email">
                                                            <i class="fas fa-envelope"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@invoice.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger" 
                                                                onclick="return confirm('Are you sure you want to delete this invoice?')" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No invoices found</h5>
                            <p class="text-muted">Create your first invoice from a project.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Invoice Modal -->
<div class="modal fade" id="createInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>
                    Create Invoice
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ProjectId" class="form-label"></label>
                            <select asp-for="Input.ProjectId" class="form-select" id="projectSelect">
                                <option value="">Select a project...</option>
                                @foreach (var project in Model.Projects.Where(p => p.Status == "Active"))
                                {
                                    <option value="@project.Id" data-client="@project.ClientName" data-budget="@project.Budget" data-spent="@project.TotalAmount">
                                        @project.Name - @project.ClientName
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="Input.ProjectId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.InvoiceDate" class="form-label"></label>
                            <input asp-for="Input.InvoiceDate" class="form-control" />
                            <span asp-validation-for="Input.InvoiceDate" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.DueDate" class="form-label"></label>
                            <input asp-for="Input.DueDate" class="form-control" />
                            <span asp-validation-for="Input.DueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Project Summary</label>
                            <div id="projectSummary" class="form-control-plaintext">
                                <small class="text-muted">Select a project to see summary</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Notes" class="form-label"></label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3" placeholder="Additional notes for the invoice..."></textarea>
                        <span asp-validation-for="Input.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Create Invoice
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Update project summary when project is selected
            $('#projectSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var client = selectedOption.data('client');
                var budget = selectedOption.data('budget');
                var spent = selectedOption.data('spent');
                
                if (client) {
                    var summary = `Client: ${client}<br>Budget: $${budget.toLocaleString()}<br>Spent: $${spent.toLocaleString()}`;
                    $('#projectSummary').html(summary);
                } else {
                    $('#projectSummary').html('<small class="text-muted">Select a project to see summary</small>');
                }
            });
        });
    </script>
}
