@page
@model CadenceAccounting.Pages.Projects.DetailsModel
@{
    ViewData["Title"] = "Project Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    @if (Model.Project != null)
    {
        <!-- Project Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>
                            <i class="fas fa-project-diagram me-2"></i>
                            @Model.Project.Name
                        </h2>
                        <p class="text-muted mb-0">@Model.Project.ProjectNumber</p>
                    </div>
                    <div class="btn-group">
                        <a href="/TimeTracking/Index" class="btn btn-outline-primary">
                            <i class="fas fa-clock me-2"></i>
                            Add Time
                        </a>
                        <a href="/Expenses/Index" class="btn btn-outline-success">
                            <i class="fas fa-receipt me-2"></i>
                            Add Expense
                        </a>
                        <a href="/Invoices/Index" class="btn btn-outline-info">
                            <i class="fas fa-file-invoice me-2"></i>
                            Create Invoice
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Project Information -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Project Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Client Information</h6>
                                <p><strong>Client:</strong> @Model.Project.ClientName</p>
                                @if (!string.IsNullOrEmpty(Model.Project.ClientEmail))
                                {
                                    <p><strong>Email:</strong> @Model.Project.ClientEmail</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.Project.ClientPhone))
                                {
                                    <p><strong>Phone:</strong> @Model.Project.ClientPhone</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.Project.ClientAddress))
                                {
                                    <p><strong>Address:</strong> @Model.Project.ClientAddress</p>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6>Project Details</h6>
                                <p><strong>Status:</strong> 
                                    @if (Model.Project.BudgetUtilization >= 100)
                                    {
                                        <span class="badge bg-danger">Over Budget</span>
                                    }
                                    else if (Model.Project.BudgetUtilization >= 90)
                                    {
                                        <span class="badge bg-warning">Near Limit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Model.Project.Status</span>
                                    }
                                </p>
                                <p><strong>Start Date:</strong> @Model.Project.StartDate.ToString("MM/dd/yyyy")</p>
                                @if (Model.Project.EndDate.HasValue)
                                {
                                    <p><strong>End Date:</strong> @Model.Project.EndDate.Value.ToString("MM/dd/yyyy")</p>
                                }
                                <p><strong>Tax Type:</strong> @Model.Project.TaxType</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Project.Description))
                        {
                            <hr>
                            <h6>Description</h6>
                            <p>@Model.Project.Description</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Budget Overview</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Budget:</span>
                            <span>@Model.Project.Budget.ToString("C0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Spent:</span>
                            <span>@Model.Project.TotalAmount.ToString("C0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Remaining:</span>
                            <span class="@(Model.Project.RemainingBudget >= 0 ? "text-success" : "text-danger")">
                                @Model.Project.RemainingBudget.ToString("C0")
                            </span>
                        </div>
                        <hr>
                        <div class="budget-progress mb-3">
                            <div class="budget-progress-bar" style="width: @Math.Min(100, Model.Project.BudgetUtilization)%"></div>
                            <div class="budget-progress-text">@Model.Project.BudgetUtilization.ToString("F1")%</div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">Hourly Rate:</small>
                            <small class="text-muted">@Model.Project.HourlyRate.ToString("C")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Time Entries -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Time Entries</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.TimeEntries.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Description</th>
                                            <th>Hours</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                            <th>Billable</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in Model.TimeEntries.Take(10))
                                        {
                                            <tr>
                                                <td>@entry.Date.ToString("MM/dd/yyyy")</td>
                                                <td>@entry.Description</td>
                                                <td>@entry.Hours.ToString("F2")</td>
                                                <td>@entry.Rate.ToString("C")</td>
                                                <td>@entry.Amount.ToString("C")</td>
                                                <td>
                                                    @if (entry.IsBillable)
                                                    {
                                                        <span class="badge bg-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (Model.TimeEntries.Count() > 10)
                            {
                                <small class="text-muted">Showing first 10 of @Model.TimeEntries.Count() entries</small>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-clock fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">No time entries recorded</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Expenses -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Recent Expenses</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Expenses.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Description</th>
                                            <th>Category</th>
                                            <th>Amount</th>
                                            <th>Billable</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var expense in Model.Expenses.Take(10))
                                        {
                                            <tr>
                                                <td>@expense.Date.ToString("MM/dd/yyyy")</td>
                                                <td>@expense.Description</td>
                                                <td>@expense.Category</td>
                                                <td>@expense.Amount.ToString("C")</td>
                                                <td>
                                                    @if (expense.IsBillable)
                                                    {
                                                        <span class="badge bg-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (Model.Expenses.Count() > 10)
                            {
                                <small class="text-muted">Showing first 10 of @Model.Expenses.Count() entries</small>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-receipt fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">No expenses recorded</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoices -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Project Invoices</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Invoices.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Date</th>
                                            <th>Due Date</th>
                                            <th>Amount</th>
                                            <th>Paid</th>
                                            <th>Balance</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var invoice in Model.Invoices)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="/Invoices/Details/@invoice.Id" class="text-decoration-none">
                                                        @invoice.InvoiceNumber
                                                    </a>
                                                </td>
                                                <td>@invoice.InvoiceDate.ToString("MM/dd/yyyy")</td>
                                                <td>@invoice.DueDate.ToString("MM/dd/yyyy")</td>
                                                <td>@invoice.TotalAmount.ToString("C")</td>
                                                <td>@invoice.TotalPaid.ToString("C")</td>
                                                <td>@invoice.Balance.ToString("C")</td>
                                                <td>
                                                    @if (invoice.IsPaid)
                                                    {
                                                        <span class="badge bg-success">Paid</span>
                                                    }
                                                    else if (invoice.DueDate < DateTime.Today)
                                                    {
                                                        <span class="badge bg-danger">Overdue</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">@invoice.Status</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-file-invoice fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">No invoices created</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-exclamation-triangle fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">Project not found</h5>
            <a href="/Projects" class="btn btn-primary">Back to Projects</a>
        </div>
    }
</div>
