@page "/Projects/Edit/{id:guid}"
@model CadenceAccounting.Pages.Projects.EditModel
@{
    ViewData["Title"] = "Edit Project";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-edit me-2"></i>
                    Edit Project: @Model.Project?.Name
                </h2>
                <a href="/Projects/Details/@Model.Project?.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back to Details
                </a>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Project != null)
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Project Information</h5>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="Input.Name" class="form-label">Project Name</label>
                                    <input name="Input.Name" value="@Model.Project.Name" class="form-control" />
                                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Input.ProjectNumber" class="form-label">Project Number</label>
                                    <input name="Input.ProjectNumber" value="@Model.Project.ProjectNumber" class="form-control" />
                                    <span asp-validation-for="Input.ProjectNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="Input.CompanyId" class="form-label">Company</label>
                                    <select name="Input.CompanyId" class="form-select">
                                        <option value="">-- Select Company --</option>
                                        @foreach (var company in Model.Companies)
                                        {
                                            <option value="@company.Id" @(company.Id == Model.Project.CompanyId ? "selected" : "")>@company.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.CompanyId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Input.Status" class="form-label">Status</label>
                                    <select name="Input.Status" class="form-select">
                                        <option value="Active" @(Model.Project.Status == "Active" ? "selected" : "")>Active</option>
                                        <option value="On Hold" @(Model.Project.Status == "On Hold" ? "selected" : "")>On Hold</option>
                                        <option value="Completed" @(Model.Project.Status == "Completed" ? "selected" : "")>Completed</option>
                                        <option value="Cancelled" @(Model.Project.Status == "Cancelled" ? "selected" : "")>Cancelled</option>
                                    </select>
                                    <span asp-validation-for="Input.Status" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="Input.Budget" class="form-label">Budget</label>
                                    <input name="Input.Budget" type="number" step="0.01" value="@Model.Project.Budget" class="form-control" />
                                    <span asp-validation-for="Input.Budget" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Input.HourlyRate" class="form-label">Hourly Rate</label>
                                    <input name="Input.HourlyRate" type="number" step="0.01" value="@Model.Project.HourlyRate" class="form-control" />
                                    <span asp-validation-for="Input.HourlyRate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="Input.StartDate" class="form-label">Start Date</label>
                                    <input name="Input.StartDate" type="date" value="@Model.Project.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
                                    <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Input.EndDate" class="form-label">End Date</label>
                                    <input name="Input.EndDate" type="date" value="@(Model.Project.EndDate?.ToString("yyyy-MM-dd") ?? "")" class="form-control" />
                                    <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="Input.TaxType" class="form-label">Tax Type</label>
                                    <select name="Input.TaxType" class="form-select">
                                        <option value="1099" @(Model.Project.TaxType == "1099" ? "selected" : "")>1099</option>
                                        <option value="W-2" @(Model.Project.TaxType == "W-2" ? "selected" : "")>W-2</option>
                                        <option value="Corp-to-Corp" @(Model.Project.TaxType == "Corp-to-Corp" ? "selected" : "")>Corp-to-Corp</option>
                                    </select>
                                    <span asp-validation-for="Input.TaxType" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="Input.Description" class="form-label">Description</label>
                                <textarea name="Input.Description" class="form-control" rows="3">@Model.Project.Description</textarea>
                                <span asp-validation-for="Input.Description" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="Input.ClientEmail" class="form-label">Client Email</label>
                                    <input name="Input.ClientEmail" type="email" value="@Model.Project.ClientEmail" class="form-control" />
                                    <span asp-validation-for="Input.ClientEmail" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="Input.ClientPhone" class="form-label">Client Phone</label>
                                    <input name="Input.ClientPhone" value="@Model.Project.ClientPhone" class="form-control" />
                                    <span asp-validation-for="Input.ClientPhone" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="Input.ClientAddress" class="form-label">Client Address</label>
                                <textarea name="Input.ClientAddress" class="form-control" rows="2">@Model.Project.ClientAddress</textarea>
                                <span asp-validation-for="Input.ClientAddress" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="/Projects/Details/@Model.Project.Id" class="btn btn-secondary">
                                    <i class="fas fa-times me-2"></i>
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i>
                                    Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-exclamation-triangle fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Project not found</h5>
                    <a href="/Projects" class="btn btn-primary">Back to Projects</a>
                </div>
            }
        </div>
    </div>
</div>
