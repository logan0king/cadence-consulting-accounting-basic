@page
@model CadenceAccounting.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Projects";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-project-diagram me-2"></i>
                    Projects
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                    <i class="fas fa-plus me-2"></i>
                    Create Project
                </button>
            </div>

            <!-- Projects Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Projects</h5>
                </div>
                <div class="card-body">
                    @if (Model.Projects.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Client</th>
                                        <th>Budget</th>
                                        <th>Spent</th>
                                        <th>Utilization</th>
                                        <th>Status</th>
                                        <th>Start Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var project in Model.Projects)
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <a href="/Projects/Details/@project.Id" class="text-decoration-none fw-bold">
                                                        @project.Name
                                                    </a>
                                                    <br>
                                                    <small class="text-muted">@project.ProjectNumber</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    @project.ClientName
                                                    @if (!string.IsNullOrEmpty(project.ClientEmail))
                                                    {
                                                        <br><small class="text-muted">@project.ClientEmail</small>
                                                    }
                                                </div>
                                            </td>
                                            <td>@project.Budget.ToString("C0")</td>
                                            <td>@project.TotalAmount.ToString("C0")</td>
                                            <td>
                                                <div class="budget-progress" style="height: 20px;">
                                                    <div class="budget-progress-bar" style="width: @Math.Min(100, project.BudgetUtilization)%"></div>
                                                    <div class="budget-progress-text">@project.BudgetUtilization.ToString("F1")%</div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (project.BudgetUtilization >= 100)
                                                {
                                                    <span class="badge bg-danger">Over Budget</span>
                                                }
                                                else if (project.BudgetUtilization >= 90)
                                                {
                                                    <span class="badge bg-warning">Near Limit</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">@project.Status</span>
                                                }
                                            </td>
                                            <td>@project.StartDate.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/Projects/Details/@project.Id" class="btn btn-outline-primary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <form method="post" action="?handler=Delete&id=@project.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger" 
                                                                onclick="return confirm('Are you sure you want to delete this project?')" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-project-diagram fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No projects found</h5>
                            <p class="text-muted">Create your first project to get started.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Project Modal -->
<div class="modal fade" id="createProjectModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>
                    Create Project
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    @if (!Model.HasCompanies)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>No Companies Found!</strong> You must create at least one company before you can create projects. 
                            Please go to <a href="/Setup" class="alert-link">System Setup</a> to add companies first.
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.Name" class="form-label">Project Name</label>
                            <input name="Input.Name" class="form-control" placeholder="Enter project name..." />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.ProjectNumber" class="form-label">Project Number</label>
                            <input name="Input.ProjectNumber" class="form-control" placeholder="Enter project number..." />
                            <span asp-validation-for="Input.ProjectNumber" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Input.Description" class="form-label">Description</label>
                        <textarea name="Input.Description" class="form-control" rows="3" placeholder="Describe the project..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.CompanyId" class="form-label">Company</label>
                            <select name="Input.CompanyId" class="form-select" @(Model.HasCompanies ? "" : "disabled")>
                                <option value="">-- Select Company --</option>
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.Id">@company.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Input.CompanyId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.ClientEmail" class="form-label">Client Email</label>
                            <input name="Input.ClientEmail" type="email" class="form-control" placeholder="Enter client email..." />
                            <span asp-validation-for="Input.ClientEmail" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.ClientPhone" class="form-label">Client Phone</label>
                            <input name="Input.ClientPhone" class="form-control" placeholder="Enter client phone..." />
                            <span asp-validation-for="Input.ClientPhone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.TaxType" class="form-label">Tax Type</label>
                            <select name="Input.TaxType" class="form-select">
                                <option value="1099">1099</option>
                                <option value="W2">W2</option>
                                <option value="Corp-to-Corp">Corp-to-Corp</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Input.TaxType" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Input.ClientAddress" class="form-label">Client Address</label>
                        <textarea name="Input.ClientAddress" class="form-control" rows="2" placeholder="Enter client address..."></textarea>
                        <span asp-validation-for="Input.ClientAddress" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="Input.Budget" class="form-label">Budget</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input name="Input.Budget" type="number" step="0.01" min="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="Input.Budget" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Input.HourlyRate" class="form-label">Hourly Rate</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input name="Input.HourlyRate" type="number" step="0.01" min="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="Input.HourlyRate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Input.StartDate" class="form-label">Start Date</label>
                            <input name="Input.StartDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.EndDate" class="form-label">End Date</label>
                            <input name="Input.EndDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.ContractFile" class="form-label">Contract File</label>
                            <input name="Input.ContractFile" class="form-control" type="file" accept=".pdf,.doc,.docx" />
                            <div class="form-text">Upload contract document (PDF, DOC, DOCX)</div>
                            <span asp-validation-for="Input.ContractFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" @(Model.HasCompanies ? "" : "disabled")>
                        <i class="fas fa-save me-2"></i>
                        Create Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @* Validation scripts removed to prevent client-side validation interference *@
}
