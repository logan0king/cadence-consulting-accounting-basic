@page
@model CadenceAccounting.Pages.TimeTracking.IndexModel
@{
    ViewData["Title"] = "Time Tracking";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-clock me-2"></i>
                    Time Tracking
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTimeEntryModal">
                    <i class="fas fa-plus me-2"></i>
                    Add Time Entry
                </button>
            </div>

            <!-- Time Entries Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Time Entries</h5>
                </div>
                <div class="card-body">
                    @if (Model.TimeEntries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Project</th>
                                        <th>Description</th>
                                        <th>Hours</th>
                                        <th>Rate</th>
                                        <th>Amount</th>
                                        <th>Billable</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model.TimeEntries)
                                    {
                                        <tr>
                                            <td>@entry.Date.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                <span class="badge bg-primary">@entry.Project.Name</span>
                                            </td>
                                            <td>@entry.Description</td>
                                            <td>@entry.Hours.ToString("F2")</td>
                                            <td>@entry.Rate.ToString("C")</td>
                                            <td>@entry.Amount.ToString("C")</td>
                                            <td>
                                                @if (entry.IsBillable)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/TimeTracking/Edit/@entry.Id" class="btn btn-outline-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@entry.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger" 
                                                                onclick="return confirm('Are you sure you want to delete this time entry?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No time entries found</h5>
                            <p class="text-muted">Start tracking your time by adding your first entry.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Time Entry Modal -->
<div class="modal fade" id="addTimeEntryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>
                    Add Time Entry
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Input.ProjectId" class="form-label">Project</label>
                            <select name="Input.ProjectId" class="form-select" id="projectSelect">
                                <option value="">Select a project...</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id" data-rate="@project.HourlyRate">@project.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Input.ProjectId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Input.Date" class="form-label">Date</label>
                            <input name="Input.Date" type="date" class="form-control" value="@Model.Input.Date.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Input.Date" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="Input.Hours" class="form-label">Hours</label>
                            <div class="input-group">
                                <input name="Input.Hours" type="number" class="form-control" step="0.1" min="0" max="24" value="@Model.Input.Hours" />
                                <span class="input-group-text">hrs</span>
                            </div>
                            <span asp-validation-for="Input.Hours" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Input.Rate" class="form-label">Rate</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input name="Input.Rate" type="number" class="form-control" step="0.01" min="0.01" value="@Model.Input.Rate" />
                            </div>
                            <span asp-validation-for="Input.Rate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control" id="amountDisplay" readonly />
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Input.Description" class="form-label">Description</label>
                        <textarea name="Input.Description" class="form-control" rows="3" placeholder="Describe the work performed...">@Model.Input.Description</textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input name="Input.IsBillable" type="checkbox" class="form-check-input" @(Model.Input.IsBillable ? "checked" : "") />
                        <label for="Input.IsBillable" class="form-check-label">Billable</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Save Time Entry
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-populate rate when project is selected
            $('#projectSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var rate = selectedOption.data('rate');
                if (rate) {
                    $('input[name="Input.Rate"]').val(rate);
                    calculateAmount();
                }
            });

            // Calculate amount when hours or rate changes (input event)
            $('input[name="Input.Hours"], input[name="Input.Rate"]').on('input', calculateAmount);
            
            // Calculate amount when focus leaves hours or rate fields
            $('input[name="Input.Hours"], input[name="Input.Rate"]').on('blur', calculateAmount);

            function calculateAmount() {
                var hours = parseFloat($('input[name="Input.Hours"]').val()) || 0;
                var rate = parseFloat($('input[name="Input.Rate"]').val()) || 0;
                var amount = hours * rate;
                $('#amountDisplay').val(amount.toFixed(2));
            }


            // Initialize amount calculation
            calculateAmount();
        });
    </script>
}
